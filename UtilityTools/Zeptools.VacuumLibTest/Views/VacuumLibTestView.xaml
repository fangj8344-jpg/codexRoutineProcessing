<UserControl x:Class="UtilityTools.VacuumLibTest.Views.VacuumLibTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:model="clr-namespace:UtilityTools.VacuumLibTest.Model"
             xmlns:cv="clr-namespace:UtilityTools.Core.Converter;assembly=UtilityTools.Core"
             xmlns:local="clr-namespace:UtilityTools.VacuumLibTest.Views"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    
    <UserControl.Resources>
        <cv:BoolToColorConverter x:Key="boolToColorConverter" />
    </UserControl.Resources>

    <md:DialogHost Identifier="{x:Static model:CommonModel.VacuumLibTestRegionName}"
                   DialogTheme="Inherit">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0"
                       Margin="10"
                       LastChildFill="False">
                <TextBlock Text="真空监控"
                           FontSize="20"
                           FontWeight="Bold"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding ShowDeviceCommand}"
                        Content="{md:PackIcon Kind=UsbPort, Size=24}"
                        Style="{StaticResource MaterialDesignToolButton}"
                        Foreground="{Binding IsConnected, Converter={StaticResource boolToColorConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <UniformGrid Columns="3"
                         Grid.Row="1">

                <GroupBox Header="真空读取">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="4*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <Button Content="获取所有"
                                    Command="{Binding UpdateVacVauleCommand}"
                                    CommandParameter="All" />
                        </DockPanel>

                        <UniformGrid Grid.Row="1"
                                     Columns="3">
                            <Label Content="CH1"
                                   VerticalContentAlignment="Center"
                                   HorizontalContentAlignment="Center" />
                            <TextBox Text="{Binding Model.VacValue1}"
                                     VerticalContentAlignment="Center"
                                     VerticalAlignment="Center" />
                            <Button Content="更新"
                                    Command="{Binding UpdateVacVauleCommand}"
                                    CommandParameter="1" />

                            <Label Content="CH2"
                                   VerticalContentAlignment="Center"
                                   HorizontalContentAlignment="Center" />
                            <TextBox Text="{Binding Model.VacValue2}"
                                     VerticalContentAlignment="Center"
                                     VerticalAlignment="Center" />
                            <Button Content="更新"
                                    Command="{Binding UpdateVacVauleCommand}"
                                    CommandParameter="2" />

                            <Label Content="CH3"
                                   VerticalContentAlignment="Center"
                                   HorizontalContentAlignment="Center" />
                            <TextBox Text="{Binding Model.VacValue3}"
                                     VerticalContentAlignment="Center"
                                     VerticalAlignment="Center" />
                            <Button Content="更新"
                                    Command="{Binding UpdateVacVauleCommand}"
                                    CommandParameter="3" />

                            <Label Content="CH4"
                                   VerticalContentAlignment="Center"
                                   HorizontalContentAlignment="Center" />
                            <TextBox Text="{Binding Model.VacValue4}"
                                     VerticalContentAlignment="Center"
                                     VerticalAlignment="Center" />
                            <Button Content="更新"
                                    Command="{Binding UpdateVacVauleCommand}"
                                    CommandParameter="4" />
                        </UniformGrid>
                    </Grid>
                </GroupBox>

                <GroupBox Header="低真空控制">
                    <DockPanel LastChildFill="True">
                        <Button Content="关闭低真空"
                                Command="{Binding OpLowVacuumCommand}"
                                CommandParameter="Close"
                                DockPanel.Dock="Right" />
                        <Button Content="开启低真空"
                                Command="{Binding OpLowVacuumCommand}"
                                CommandParameter="Open"
                                DockPanel.Dock="Right" />
                        <TextBox Text="{Binding Model.LowVacValue}"
                                 DockPanel.Dock="Right"
                                 VerticalContentAlignment="Center"
                                 VerticalAlignment="Center" />
                    </DockPanel>
                </GroupBox>

                <GroupBox Header="阀门控制">
                    <UniformGrid Columns="3">
                        <Label Content="闸板阀控制"
                               VerticalContentAlignment="Center"
                               HorizontalContentAlignment="Center" />
                        <TextBox Text="{Binding Model.GateValveValue}"
                                 VerticalContentAlignment="Center"
                                 VerticalAlignment="Center" />
                        <Button Content="设置"
                                Command="{Binding ValveControlCommand}"
                                CommandParameter="Gate" />

                        <Label Content="针阀控制"
                               VerticalContentAlignment="Center"
                               HorizontalContentAlignment="Center" />
                        <TextBox Text="{Binding Model.LeakValveValue}"
                                 VerticalContentAlignment="Center"
                                 VerticalAlignment="Center" />
                        <Button Content="设置"
                                Command="{Binding ValveControlCommand}"
                                CommandParameter="Leak" />
                    </UniformGrid>
                </GroupBox>

                <GroupBox Header="PID调节">
                    <DockPanel>
                        <Label Content="PID参数"
                               VerticalContentAlignment="Center"
                               HorizontalContentAlignment="Center"
                               DockPanel.Dock="Left" />
                        <Button Content="设置"
                                Command="{Binding PidControlCommand}"
                                CommandParameter="Set"
                                DockPanel.Dock="Right" />
                        <Button Content="获取"
                                Command="{Binding PidControlCommand}"
                                CommandParameter="Get"
                                DockPanel.Dock="Right" />
                        <UniformGrid Rows="1">
                            <TextBox Text="{Binding Model.P}"
                                     ToolTip="P"
                                     VerticalContentAlignment="Center"
                                     VerticalAlignment="Center" />
                            <TextBox Text="{Binding Model.I}"
                                     ToolTip="I"
                                     VerticalContentAlignment="Center"
                                     VerticalAlignment="Center" />
                            <TextBox Text="{Binding Model.D}"
                                     ToolTip="D"
                                     VerticalContentAlignment="Center"
                                     VerticalAlignment="Center" />
                        </UniformGrid>
                    </DockPanel>
                </GroupBox>

                <GroupBox Header="模块校准">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <Button Content="开始校准"
                                Grid.Row="0"
                                Command="{Binding CalibrateCommand}"
                                CommandParameter="Start" />
                        <Button Content="查询输入电压"
                                Grid.Row="1"
                                Command="{Binding CalibrateCommand}"
                                CommandParameter="CheckVol" />
                        <Button Content="查询校准参数"
                                Grid.Row="2"
                                Command="{Binding CalibrateCommand}"
                                CommandParameter="CheckParam" />
                        <UniformGrid Grid.Row="1"
                                     VerticalAlignment="Center"
                                     Grid.Column="1"
                                     Rows="1">
                            <TextBlock Text="{Binding Model.CaliVol1}" />
                            <TextBlock Text="{Binding Model.CaliVol2}" />
                            <TextBlock Text="{Binding Model.CaliVol3}" />
                            <TextBlock Text="{Binding Model.CaliVol4}" />
                        </UniformGrid>
                        <UniformGrid Grid.Row="2"
                                     VerticalAlignment="Center"
                                     Grid.Column="1"
                                     Rows="1">
                            <TextBlock Text="{Binding Model.CaliParam1}" />
                            <TextBlock Text="{Binding Model.CaliParam2}" />
                            <TextBlock Text="{Binding Model.CaliParam3}" />
                            <TextBlock Text="{Binding Model.CaliParam4}" />
                        </UniformGrid>
                    </Grid>
                </GroupBox>

                <GroupBox Header="外部端口">
                    <UniformGrid Columns="3">
                        <Label Content="端口0"
                               VerticalContentAlignment="Center"
                               HorizontalContentAlignment="Center"
                               DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="关" />
                            <ToggleButton Margin="8,0,8,0"
                                          IsChecked="{Binding Model.IOState0}" />
                            <TextBlock Text="开" />
                        </StackPanel>
                        <Button Content="设置"
                                Command="{Binding SetIOCommand}"
                                CommandParameter="0" />

                        <Label Content="端口1"
                               VerticalContentAlignment="Center"
                               HorizontalContentAlignment="Center"
                               DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="关" />
                            <ToggleButton Margin="8,0,8,0"
                                          IsChecked="{Binding Model.IOState1}" />
                            <TextBlock Text="开" />
                        </StackPanel>
                        <Button Content="设置"
                                Command="{Binding SetIOCommand}"
                                CommandParameter="1" />
                    </UniformGrid>
                </GroupBox>
            </UniformGrid>
        </Grid>
    </md:DialogHost>
</UserControl>
