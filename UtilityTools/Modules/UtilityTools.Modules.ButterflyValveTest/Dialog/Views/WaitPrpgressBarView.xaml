<UserControl x:Class="UtilityTools.Modules.ButterflyValveTest.Dialog.Views.WaitPrpgressBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:md ="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:UtilityTools.Modules.ButterflyValveTest.Dialog.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Width="400" Height="100">
            <TextBlock Text="{Binding Message}"/>
            <ProgressBar IsIndeterminate="True" Height="30" Width="400"/>
            <Button Content="确认" Command="{Binding OnConfirmCommand}" Width="100"/>
        </StackPanel>
    </Grid>
</UserControl>
