<UserControl x:Class="UtilityTools.Modules.ButterflyValveTest.Views.ButterflyValveTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:UtilityTools.Modules.ButterflyValveTest.Views"
             xmlns:model="clr-namespace:UtilityTools.Modules.ButterflyValveTest.Model"
             xmlns:cv="clr-namespace:UtilityTools.Core.Converter;assembly=UtilityTools.Core"
             xmlns:prism ="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <cv:BoolToColorConverter x:Key="BoolToColorConverter" />
    </UserControl.Resources>

    <md:DialogHost Identifier="{x:Static model:CommonModel.ButterflyValveTestName}"
           DialogTheme="Inherit">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0"
             Margin="10"
             LastChildFill="False">
                <TextBlock Text="蝶阀测试"
                 FontSize="20"
                 FontWeight="Bold"
                 DockPanel.Dock="Left"
                 VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right"
                      Content="{md:PackIcon Kind= UsbPort, Size=24}"
                      Foreground="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      Style="{StaticResource MaterialDesignToolButton}"
                      Command="{Binding ShowDeviceCommand}"/>
                <Button DockPanel.Dock="Right"
                      Content="{md:PackIcon Kind=EthernetCable, Size=24}"
                      Foreground="{Binding  NetIsConnected, Converter={StaticResource BoolToColorConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      Command="{Binding ShowNetDeviceCommand}"
                      Style="{StaticResource MaterialDesignToolButton}"/>

            </DockPanel>
            <local:ButterflyValveTestContentView Grid.Row="1" DataContext="{Binding Model}" />
        </Grid>
    </md:DialogHost>
</UserControl>
