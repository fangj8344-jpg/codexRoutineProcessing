<UserControl x:Class="UtilityTools.Modules.VacMonitor.Views.VacMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:model="clr-namespace:UtilityTools.Modules.VacMonitor.Model"
             xmlns:cv="clr-namespace:UtilityTools.Core.Converter;assembly=UtilityTools.Core"
             xmlns:attach="clr-namespace:UtilityTools.Core.Attach;assembly=UtilityTools.Core"
             xmlns:local="clr-namespace:UtilityTools.Modules.VacMonitor.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <cv:BoolToColorConverter x:Key="boolToColorConverter" />
    </UserControl.Resources>

    <md:DialogHost Identifier="{x:Static model:CommonModel.VacMonitorRegionName}"
                   DialogTheme="Inherit">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0"
                       Margin="10"
                       LastChildFill="False">
                <TextBlock Text="真空监控"
                           FontSize="20"
                           FontWeight="Bold"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding ShowDeviceCommand}"
                        Content="{md:PackIcon Kind=UsbPort, Size=24}"
                        Style="{StaticResource MaterialDesignToolButton}"
                        Foreground="{Binding IsConnected, Converter={StaticResource boolToColorConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <DockPanel Grid.Row="1"
                       LastChildFill="True">
                <ListView Visibility="{Binding IsChecked, ElementName=checkBox, Converter={StaticResource BooleanToVisibilityConverter}}"
                          ItemsSource="{Binding LogSource}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="时间"
                                            Width="auto"
                                            DisplayMemberBinding="{Binding Time, StringFormat={}{0:HH:mm:ss}}" />
                            <GridViewColumn Header="报文"
                                            DisplayMemberBinding="{Binding Message}" />
                            <GridViewColumn Header="方向"
                                            Width="auto"
                                            DisplayMemberBinding="{Binding Direct}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <oxy:PlotView Model="{Binding VacuumPlotModel}" />
            </DockPanel>

            <DockPanel Grid.Row="2"
                       Margin="10"
                       LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Command="{Binding ClearMonitorCommand}"
                        Content="清除监控信息"
                        Margin="5, 0, 5, 0" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding ChangeMonitorStateCommand}"
                        Content="{Binding MonitorState}"
                        Margin="5, 0, 5, 0" />
                <CheckBox Content="Log"
                          VerticalAlignment="Center"
                          x:Name="checkBox"
                          Margin="5, 0, 5, 0" />
                <Label Content="采样间隔(ms):"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left"
                       Margin="5, 0, 5, 0" />
                <TextBox Text="{Binding MonitorInterval}"
                         VerticalAlignment="Center"
                         Padding="10, 0, 12, 0"
                         attach:TextBoxAttached.IsEnterEndEdit="True"
                         attach:TextBoxAttached.IsOnlyNumbers="True"
                         attach:TextBoxAttached.IsSupportWheel="True"
                         DockPanel.Dock="Left"
                         Margin="5, 0, 5, 0" />
            </DockPanel>
        </Grid>
    </md:DialogHost>
</UserControl>
