<UserControl x:Class="UtilityTools.Modules.NetController.Views.NetControllerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cv="clr-namespace:UtilityTools.Core.Converter;assembly=UtilityTools.Core"
             xmlns:ex="clr-namespace:UtilityTools.Core.Extension;assembly=UtilityTools.Core"
             xmlns:model="clr-namespace:UtilityTools.Modules.NetController.Model"
             xmlns:local="clr-namespace:UtilityTools.Modules.NetController.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600"
             d:DesignWidth="800">
    <UserControl.Resources>
        <cv:BoolToColorConverter x:Key="BoolToColorConverter" />
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Margin="10"
                   LastChildFill="False">
            <TextBlock Text="网络通讯控制板"
                       FontSize="20"
                       FontWeight="Bold"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right"
                    Command="{Binding ExecuteCommand}"
                    CommandParameter="ShowNetConf"
                    Content="{md:PackIcon Kind=EthernetCable, Size=24}"
                    Style="{StaticResource MaterialDesignToolButton}"
                    Foreground="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <local:VacuumView DataContext="{Binding Vacuum}" Grid.Row="0" Grid.Column="0"/>
            
            <local:TemperatureView DataContext="{Binding Temperature}" Grid.Row="0" Grid.Column="1"/>
            
            <local:RelayView DataContext="{Binding Relay}" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"/>
            
            <local:CCSView DataContext="{Binding CCS}" Grid.Row="1" Grid.ColumnSpan="4"/>
            
            <local:DacView DataContext="{Binding DAC}" Grid.Row="2" Grid.Column="0"/>
            
            <local:LightView DataContext="{Binding Light}" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"/>
        </Grid>
    </Grid>
</UserControl>
