<UserControl x:Class="Zeptools.Modules.AuthorityManager.Views.AuthorityManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
    <Grid Background="#222">
        <Border Margin="10"
                Padding="20"
                CornerRadius="10"
                Background="#333">
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="授权管理"
                                   DockPanel.Dock="Left"
                                   FontSize="18"
                                   Foreground="White"
                                   Margin="10" />
                        <Button Content="加载授权文件"
                                DockPanel.Dock="Right"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="40"
                                Command="{Binding LoadAuthorityCommand}" />
                    </DockPanel>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="机器码"
                                   VerticalAlignment="Center"
                                   Foreground="White" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Margin="10"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Authority.MachineCode, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="授权私钥"
                                   VerticalAlignment="Center"
                                   Foreground="White" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="10"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Authority.PrivateKey, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="授权公钥"
                                   VerticalAlignment="Center"
                                   Foreground="White" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="10"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Authority.PublicKey, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <DataGrid ItemsSource="{Binding Authority.AuthorityItems, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              HorizontalAlignment="Stretch"
                              CanUserAddRows="False"
                              FontSize="18"
                              VerticalAlignment="Stretch">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Center" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell"
                                   BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="HorizontalAlignment"
                                        Value="Center" />
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="模块名称"
                                                IsReadOnly="True"
                                                Binding="{Binding ModuleName}"
                                                Width="*" />
                            <DataGridCheckBoxColumn Header="是否激活"
                                                    Binding="{Binding IsActived, Mode=TwoWay}"
                                                    Width="*" />
                            <DataGridCheckBoxColumn Header="是否试用"
                                                    Binding="{Binding IsTrial, Mode=TwoWay}"
                                                    Width="*" />
                            <DataGridTextColumn Header="试用时间"
                                                Binding="{Binding TrialTime, Mode=TwoWay, StringFormat='yyyy-MM-dd'}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Content="生成授权文件"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="40"
                            Margin="0,10"
                            Command="{Binding SaveAuthorityCommand}" />

                    <Line Stroke="AliceBlue"
                          Height="2"
                          Margin="5" />

                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="私钥"
                                   VerticalAlignment="Center"
                                   Foreground="White" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Margin="10"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding PrivateKey, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="公钥"
                                   VerticalAlignment="Center"
                                   Foreground="White" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="10"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding PublicKey, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>


                    <Button Content="生成密钥对"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#03A9F4"
                            Foreground="Black"
                            Height="40"
                            Command="{Binding GenerateKeyPairCommand}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl> 