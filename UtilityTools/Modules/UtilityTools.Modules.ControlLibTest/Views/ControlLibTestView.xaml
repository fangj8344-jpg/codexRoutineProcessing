<UserControl x:Class="UtilityTools.Modules.ControlLibTest.Views.ControlLibTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mt="clr-namespace:UtilityTools.Modules.ControlLibTest.Method"
             xmlns:local="clr-namespace:UtilityTools.Modules.ControlLibTest.Views"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <mt:GetRelayListConverter x:Key="getRelayListConverter" />
    </UserControl.Resources>

    <TabControl>
        <TabItem Header="CCS">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="51*" />
                    <ColumnDefinition Width="733*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           Grid.ColumnSpan="2">
                    <Label Content="通用数值控制" />
                    <ComboBox ItemsSource="{Binding CCSModels}"
                              Margin="5, 0"
                              MinWidth="50"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedCCSModelForValue}"
                              Width="50" />
                    <Slider Minimum="{Binding SelectedCCSModelForValue.MinValue}"
                            Maximum="{Binding SelectedCCSModelForValue.MaxValue}"
                            Value="{Binding SelectedCCSModelForValue.Value, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                </DockPanel>

                <DockPanel Grid.ColumnSpan="2"
                           Margin="0,25,0,0"
                           Grid.RowSpan="2">
                    <Label Content="通用开关控制" />
                    <ComboBox ItemsSource="{Binding CCSModels, Converter={StaticResource getRelayListConverter}}"
                              Margin="5, 0"
                              MinWidth="50"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedCCSModelForRelay}"
                              VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Text="关"
                                   VerticalAlignment="Center" />
                        <ToggleButton Margin="8,0,8,0"
                                      IsChecked="{Binding SelectedCCSModelForRelay.RelayState, Mode=TwoWay}" />
                        <TextBlock Text="开"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Margin="0,25,0,0"
                      Grid.RowSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="109*" />
                        <ColumnDefinition Width="19*" />
                        <ColumnDefinition Width="497*" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="156*" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl Grid.Column="0"
                                  ItemsSource="{Binding CCSModels}"
                                  Grid.ColumnSpan="3"
                                  Margin="0,0,10,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Label Content="{Binding RealName}"
                                           ToolTip="{Binding Name}"
                                           MinWidth="100"
                                           HorizontalContentAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           DockPanel.Dock="Left" />
                                    <TextBox Text="{Binding Value, Mode=TwoWay}"
                                             MinWidth="60"
                                             HorizontalContentAlignment="Center"
                                             VerticalAlignment="Center"
                                             DockPanel.Dock="Right" />
                                    <Slider Minimum="{Binding MinValue}"
                                            Maximum="{Binding MaxValue}"
                                            Value="{Binding Value, Mode=TwoWay}"
                                            VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <GridSplitter Grid.Column="3"
                                  Width="3"
                                  HorizontalAlignment="Center"
                                  Margin="0,5,0,5" />

                    <ItemsControl Grid.Column="4"
                                  ItemsSource="{Binding CCSModels, Converter={StaticResource getRelayListConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Label Content="{Binding RelayName}"
                                           ToolTip="{Binding Name}"
                                           Width="80"
                                           HorizontalContentAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           DockPanel.Dock="Left" />
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="关"
                                                   VerticalAlignment="Center" />
                                        <ToggleButton Margin="8,0,8,0"
                                                      IsChecked="{Binding RelayState}" />
                                        <TextBlock Text="开"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="FAN">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Label Content="通用风扇控制" />
                    <ComboBox ItemsSource="{Binding FanModels}"
                              Margin="5, 0"
                              MinWidth="50"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedFanModel}"
                              VerticalAlignment="Center" />
                    <Slider Minimum="{Binding SelectedFanModel.MinSpeed}"
                            Maximum="{Binding SelectedFanModel.MaxSpeed}"
                            Value="{Binding SelectedFanModel.Speed, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                </DockPanel>

                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding FanModels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <Label Content="{Binding Name}"
                                       Width="80"
                                       HorizontalContentAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left" />
                                <TextBox Text="{Binding Speed, Mode=TwoWay, StringFormat={}{0:D}}"
                                         MinWidth="60"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center"
                                         DockPanel.Dock="Right" />
                                <Slider Minimum="{Binding MinSpeed}"
                                        Maximum="{Binding MaxSpeed}"
                                        Value="{Binding Speed, Mode=TwoWay}"
                                        VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </TabItem>
        <TabItem Header="LED"></TabItem>
        <TabItem Header="ETH">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Label Content="设置以太网IP"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                    <Button Content="设置"
                            Command="{Binding SetIPCommand}"
                            Margin="10"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center" />
                    <TextBox Text="{Binding EthModel.SetIP}"
                             VerticalAlignment="Center" />
                </DockPanel>

                <DockPanel Grid.Row="1">
                    <Label Content="获取以太网IP"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                    <Button Content="获取"
                            Command="{Binding GetIPCommand}"
                            Margin="10"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center" />
                    <TextBox Text="{Binding EthModel.RealIP}"
                             VerticalAlignment="Center" />
                </DockPanel>
            </Grid>
        </TabItem>
        <TabItem Header="TEMP">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           LastChildFill="False">
                    <Button Content="读取所有"
                            Command="{Binding GetAllTempCommand}"
                            DockPanel.Dock="Right" />
                </DockPanel>

                <DockPanel Grid.Row="1">
                    <Label Content="温度传感器1"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                    <Button Content="获取"
                            Command="{Binding GetTemp1Command}"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center" />
                    <TextBlock Text="{Binding TempModel.Value1}"
                               Margin="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </DockPanel>

                <DockPanel Grid.Row="2">
                    <Label Content="温度传感器2"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                    <Button Content="获取"
                            Command="{Binding GetTemp2Command}"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center" />
                    <TextBlock Text="{Binding TempModel.Value2}"
                               Margin="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </DockPanel>
            </Grid>
        </TabItem>
        <TabItem Header="VAC">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Label Content="真空规CH1"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                    <Button Content="获取"
                            Command="{Binding GetVacCommand}"
                            CommandParameter="1"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center" />
                    <TextBlock Text="{Binding VacModel.Value1}"
                               Margin="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </DockPanel>

                <DockPanel Grid.Row="1">
                    <Label Content="真空规CH2"
