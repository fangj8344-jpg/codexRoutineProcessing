                                 VerticalAlignment="Center"
                                 DockPanel.Dock="Right" />
                        <Slider Minimum="{Binding ScanModel.MinValue}"
                                Maximum="{Binding ScanModel.MaxValue}"
                                Value="{Binding ScanModel.AnalogSpinD, Mode=TwoWay}"
                                VerticalAlignment="Center" />
                    </DockPanel>

                </Grid>

                <GridSplitter Grid.Column="1"
                              Width="3"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Margin="5" />

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="True"
                               Grid.Row="0">
                        <Label Content="K1"
                               Width="80"
                               HorizontalContentAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="关"
                                       VerticalAlignment="Center" />
                            <ToggleButton Margin="8,0,8,0"
                                          IsChecked="{Binding ScanModel.K1}" />
                            <TextBlock Text="开"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel LastChildFill="True"
                               Grid.Row="1">
                        <Label Content="K2"
                               Width="80"
                               HorizontalContentAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="关"
                                       VerticalAlignment="Center" />
                            <ToggleButton Margin="8,0,8,0"
                                          IsChecked="{Binding ScanModel.K2}" />
                            <TextBlock Text="开"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel LastChildFill="True"
                               Grid.Row="2">
                        <Label Content="K3"
                               Width="80"
                               HorizontalContentAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="关"
                                       VerticalAlignment="Center" />
                            <ToggleButton Margin="8,0,8,0"
                                          IsChecked="{Binding ScanModel.K3}" />
                            <TextBlock Text="开"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel LastChildFill="True"
                               Grid.Row="3">
                        <Label Content="K4"
                               Width="80"
                               HorizontalContentAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="关"
                                       VerticalAlignment="Center" />
                            <ToggleButton Margin="8,0,8,0"
                                          IsChecked="{Binding ScanModel.K4}" />
                            <TextBlock Text="开"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel LastChildFill="True"
                               Grid.Row="4">
                        <Label Content="SW"
                               Width="80"
                               HorizontalContentAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="关"
                                       VerticalAlignment="Center" />
                            <ToggleButton Margin="8,0,8,0"
                                          IsChecked="{Binding ScanModel.SW}" />
                            <TextBlock Text="开"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>


                </Grid>

            </Grid>

        </TabItem>
        <TabItem Header="RELAY">
            <Grid Margin="5">
                <ItemsControl Grid.Column="2"
                              ItemsSource="{Binding RelayModels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <Label Content="{Binding Name}"
                                       Width="80"
                                       HorizontalContentAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left" />
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="关"
                                               VerticalAlignment="Center" />
                                    <ToggleButton Margin="8,0,8,0"
                                                  IsChecked="{Binding Enable}" />
                                    <TextBlock Text="开"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

        </TabItem>
    </TabControl>
</UserControl>
