<UserControl x:Class="UtilityTools.Modules.ControlLibTest.Views.ControlLibTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mt="clr-namespace:UtilityTools.Modules.ControlLibTest.Method"
             xmlns:local="clr-namespace:UtilityTools.Modules.ControlLibTest.Views"
             xmlns:model="clr-namespace:UtilityTools.Modules.ControlLibTest.Model"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <mt:GetRelayListConverter x:Key="getRelayListConverter" />
        
        <ObjectDataProvider x:Key="enumModels"
                     MethodName="GetValues"
                     ObjectType="{x:Type model:EnumModels}">
            <ObjectDataProvider.MethodParameters>
                <x:Type Type="model:EnumModels" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        
        <ObjectDataProvider x:Key="enumFlash"
             MethodName="GetValues"
             ObjectType="{x:Type model:EnumFlash}">
            <ObjectDataProvider.MethodParameters>
                <x:Type Type="model:EnumFlash" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="enumOrient"
              MethodName="GetValues"
              ObjectType="{x:Type model:EnumOrient}">
            <ObjectDataProvider.MethodParameters>
                <x:Type Type="model:EnumOrient" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    

    <TabControl>
        <TabItem Header="CCS">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="389.98" />
                    <ColumnDefinition Width="343.02"/>
                </Grid.ColumnDefinitions>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           Grid.ColumnSpan="3" Margin="0,0,0,12" Grid.RowSpan="2">
                    <Label Content="通用数值控制" />
                    <ComboBox ItemsSource="{Binding CCSModels}"
                              Margin="5, 0"
                              MinWidth="50"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedCCSModelForValue}"
                              Width="50" />
                    <Slider Minimum="{Binding SelectedCCSModelForValue.MinValue}"
                            Maximum="{Binding SelectedCCSModelForValue.MaxValue}"
                            Value="{Binding SelectedCCSModelForValue.Value, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                </DockPanel>

                <DockPanel Grid.ColumnSpan="3"
                           Margin="0,25,0,0"
                           Grid.RowSpan="2">
                    <Label Content="通用开关控制" />
                    <ComboBox ItemsSource="{Binding CCSModels, Converter={StaticResource getRelayListConverter}}"
                              Margin="5, 0"
                              MinWidth="50"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedCCSModelForRelay}"
                              VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Text="关"
                                   VerticalAlignment="Center" />
                        <ToggleButton Margin="8,0,8,0"
                                      IsChecked="{Binding SelectedCCSModelForRelay.RelayState, Mode=TwoWay}" />
                        <TextBlock Text="开"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="2"
                      Grid.ColumnSpan="3"
                      Margin="0,13,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="109*" />
                        <ColumnDefinition Width="19*" />
                        <ColumnDefinition Width="497*" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="156*" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl Grid.Column="0"
                                  ItemsSource="{Binding CCSModels}"
                                  Grid.ColumnSpan="3"
                                  Margin="0,0,10,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Label Content="{Binding RealName}"
                                           ToolTip="{Binding Name}"
                                           MinWidth="100"
                                           HorizontalContentAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           DockPanel.Dock="Left" />
                                    <TextBox Text="{Binding Value, Mode=TwoWay}"
                                             MinWidth="60"
                                             HorizontalContentAlignment="Center"
                                             VerticalAlignment="Center"
                                             DockPanel.Dock="Right" />
                                    <Slider Minimum="{Binding MinValue}"
                                            Maximum="{Binding MaxValue}"
                                            Value="{Binding Value, Mode=TwoWay}"
                                            VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <GridSplitter Grid.Column="3"
                                  Width="3"
                                  HorizontalAlignment="Center"
                                  Margin="0,5,0,5" />

                    <ItemsControl Grid.Column="4"
                                  ItemsSource="{Binding CCSModels, Converter={StaticResource getRelayListConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Label Content="{Binding RelayName}"
                                           ToolTip="{Binding Name}"
                                           Width="80"
                                           HorizontalContentAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           DockPanel.Dock="Left" />
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="关"
                                                   VerticalAlignment="Center" />
                                        <ToggleButton Margin="8,0,8,0"
                                                      IsChecked="{Binding RelayState}" />
                                        <TextBlock Text="开"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="FAN">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Label Content="通用风扇控制" />
                    <ComboBox ItemsSource="{Binding FanModels}"
                              Margin="5, 0"
                              MinWidth="50"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedFanModel}"
                              VerticalAlignment="Center" />
                    <Slider Minimum="{Binding SelectedFanModel.MinSpeed}"
                            Maximum="{Binding SelectedFanModel.MaxSpeed}"
                            Value="{Binding SelectedFanModel.Speed, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                </DockPanel>

                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding FanModels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <Label Content="{Binding Name}"
                                       Width="80"
                                       HorizontalContentAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left" />
                                <TextBox Text="{Binding Speed, Mode=TwoWay, StringFormat={}{0:D}}"
                                         MinWidth="60"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center"
                                         DockPanel.Dock="Right" />
                                <Slider Minimum="{Binding MinSpeed}"
                                        Maximum="{Binding MaxSpeed}"
                                        Value="{Binding Speed, Mode=TwoWay}"
                                        VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </TabItem>
        <TabItem Header="LED">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118*"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="94*"/>
                    <ColumnDefinition Width="23*"/>
                    <ColumnDefinition Width="554*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <UniformGrid Grid.Row="0"
                      Rows="1"
                      VerticalAlignment="Center" Grid.ColumnSpan="5">
                    <DockPanel Margin="0, 0, 5, 0">
                        <TextBlock VerticalAlignment="Center" Text="呼吸灯周期" />
                        <TextBox Text="{Binding LedModels.TimeCycle}"
                         TextAlignment="Center" />
                    </DockPanel> 

                    <DockPanel Margin="5, 0, 0, 0">
                        <TextBlock VerticalAlignment="Center" Text="静态分段点亮" />
                        <ComboBox SelectedItem="{Binding LedModels.StaticLightModel}"
                                 ItemsSource="{Binding Source={StaticResource enumModels}}">
                            <!--<ComboBoxItem>奇数灯闪</ComboBoxItem>
                            <ComboBoxItem>偶数灯闪</ComboBoxItem>
                            <ComboBoxItem>奇偶交替闪</ComboBoxItem>-->
                        </ComboBox>
                    </DockPanel>

                    <DockPanel Margin="5, 0, 0, 0">
                        <TextBlock VerticalAlignment="Center" Text="分段模式" />
                        <ComboBox SelectedItem="{Binding LedModels.DivideLightModel}"
                                  ItemsSource="{Binding Source={StaticResource enumFlash}}">
                        </ComboBox>
                    </DockPanel>
                </UniformGrid>
                <UniformGrid Grid.Row="1"
                         Rows="1"
                         VerticalAlignment="Center" Grid.ColumnSpan="5">
                    <DockPanel Margin="0, 0, 5, 0">
                        <TextBlock VerticalAlignment="Center" Text="亮灯数" />
                        <Slider VerticalAlignment="Center" Minimum="1" Maximum="28" Value="{Binding LedModels.LightNumber,Mode=TwoWay}"></Slider>
                    </DockPanel>
                    <DockPanel Margin="0, 0, 5, 0">
                        <TextBlock VerticalAlignment="Center" Text="方向" />
                        <ComboBox SelectedItem="{Binding LedModels.Orient}"
                         ItemsSource="{Binding Source={StaticResource enumOrient}}">
                        </ComboBox>
                    </DockPanel>
                    <DockPanel Margin="5, 0, 0, 0">
                        <TextBlock VerticalAlignment="Center" Text="进度值" />
                        <Slider VerticalAlignment="Center" Minimum="1" Maximum="15" Value="{Binding LedModels.Value,Mode=TwoWay}"></Slider>
                    </DockPanel>
                </UniformGrid>
                <UniformGrid Grid.Row="2"
                    Rows="1"
                    VerticalAlignment="Center" Grid.ColumnSpan="5">
                    <DockPanel Margin="0, 0, 5, 0">
                        <TextBlock VerticalAlignment="Center" Text="R" />
                        <Slider Value="{Binding LedModels.R,Mode=TwoWay}" VerticalAlignment="Center" Minimum="1" Maximum="255"></Slider>
                    </DockPanel>

                    <DockPanel Margin="5, 0, 0, 0">
                        <TextBlock VerticalAlignment="Center" Text="G" />
                        <Slider Value="{Binding LedModels.G,Mode=TwoWay}" VerticalAlignment="Center" Minimum="1" Maximum="255"></Slider>
                    </DockPanel>

                    <DockPanel Margin="0, 0, 5, 0">
                        <TextBlock VerticalAlignment="Center" Text="B" />
                        <Slider Value="{Binding LedModels.B,Mode=TwoWay}" VerticalAlignment="Center" Minimum="1" Maximum="255"></Slider>
                    </DockPanel>
                </UniformGrid>
                <UniformGrid Grid.Row="3"
                     Rows="1"
                     VerticalAlignment="Center" Grid.ColumnSpan="5">
                    <DockPanel Margin="0, 0, 5, 0">
                        <TextBlock VerticalAlignment="Center" Text="亮度" />
                        <Slider VerticalAlignment="Center" Value="{Binding LedModels.Light,Mode=TwoWay}" Minimum="1" Maximum="255"></Slider>
                    </DockPanel>
                </UniformGrid>
                <UniformGrid Grid.Row="4"
                    Rows="1"
                    VerticalAlignment="Center" Grid.ColumnSpan="5">
                    <DockPanel Margin="0, 0, 5, 0">
                        <TextBlock Text="工作模式"
                          VerticalAlignment="Center"
                          Margin="0, 0, 5, 0" />
                        <Button
                            Command="{Binding LedModels.UpdateLightCommand}"
                            DockPanel.Dock="Right" Margin="10,0,0,0">更新灯光状态</Button>
                        <ComboBox SelectedItem="{Binding LedModels.Name}" >
                            <ComboBoxItem>静态全亮</ComboBoxItem>
                            <ComboBoxItem>静态全灭</ComboBoxItem>
                            <ComboBoxItem>全亮闪烁</ComboBoxItem>
                            <ComboBoxItem>分段闪烁</ComboBoxItem>
                            <ComboBoxItem>呼吸</ComboBoxItem>
                            <ComboBoxItem>流水（单向）</ComboBoxItem>
                            <ComboBoxItem>流水（往复）</ComboBoxItem>
                            <ComboBoxItem>进度条</ComboBoxItem>
                            <ComboBoxItem>静态分段点亮</ComboBoxItem>
                            <ComboBoxItem>默认模式</ComboBoxItem>
                            <ComboBoxItem>改变颜色</ComboBoxItem>
                            <ComboBoxItem>改变亮度</ComboBoxItem>
                        </ComboBox>
                    </DockPanel>
                </UniformGrid>
            </Grid>

        </TabItem>
        <TabItem Header="ETH">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Label Content="设置以太网IP"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                    <Button Content="设置"
                            Command="{Binding SetIPCommand}"
                            Margin="10"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center" />
                    <TextBox Text="{Binding EthModel.SetIP}"
                             VerticalAlignment="Center" />
                </DockPanel>

                <DockPanel Grid.Row="1">
                    <Label Content="获取以太网IP"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                    <Button Content="获取"
                            Command="{Binding GetIPCommand}"
                            Margin="10"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center" />
                    <TextBox Text="{Binding EthModel.RealIP}"
                             VerticalAlignment="Center" />
                </DockPanel>
            </Grid>
        </TabItem>
        <TabItem Header="TEMP">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           LastChildFill="False">
                    <Button Content="读取所有"
                            Command="{Binding GetAllTempCommand}"
                            DockPanel.Dock="Right" />
                </DockPanel>

                <DockPanel Grid.Row="1">
                    <Label Content="温度传感器1"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                    <Button Content="获取"
                            Command="{Binding GetTemp1Command}"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center" />
                    <TextBlock Text="{Binding TempModel.Value1}"
                               Margin="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </DockPanel>

                <DockPanel Grid.Row="2">
                    <Label Content="温度传感器2"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                    <Button Content="获取"
                            Command="{Binding GetTemp2Command}"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center" />
                    <TextBlock Text="{Binding TempModel.Value2}"
                               Margin="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </DockPanel>
            </Grid>
        </TabItem>
        <TabItem Header="VAC">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Label Content="真空规CH1"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                    <Button Content="获取"
                            Command="{Binding GetVacCommand}"
                            CommandParameter="1"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center" />
                    <TextBlock Text="{Binding VacModel.Value1}"
                               Margin="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </DockPanel>

                <DockPanel Grid.Row="1">
                    <Label Content="真空规CH2"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                    <Button Content="获取"
                            Command="{Binding GetVacCommand}"
                            CommandParameter="2"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center" />
                    <TextBlock Text="{Binding VacModel.Value2}"
                               Margin="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </DockPanel>

                <DockPanel Grid.Row="2">
                    <Label Content="真空规CH3"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                    <Button Content="获取"
                            Command="{Binding GetVacCommand}"
                            CommandParameter="3"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center" />
                    <TextBlock Text="{Binding VacModel.Value3}"
                               Margin="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </DockPanel>

                <DockPanel Grid.Row="3">
                    <Label Content="真空规CH4"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                    <Button Content="获取"
                            Command="{Binding GetVacCommand}"
                            CommandParameter="4"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center" />
                    <TextBlock Text="{Binding VacModel.Value4}"
                               Margin="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </DockPanel>

            </Grid>
        </TabItem>
        <TabItem Header="BSE">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Label Content="通用数值调整" />
                    <ComboBox ItemsSource="{Binding BseModels}"
                              Margin="5, 0"
                              MinWidth="50"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding BseModelForValue}"
                              VerticalAlignment="Center" />
                    <TextBox Text="{Binding BseModelForValue.Value, Mode=TwoWay}"
                             MinWidth="60"
                             HorizontalContentAlignment="Center"
                             VerticalAlignment="Center"
                             DockPanel.Dock="Right" />
                    <Slider Minimum="{Binding BseModelForValue.MinValue}"
                            Maximum="{Binding BseModelForValue.MaxValue}"
                            Value="{Binding BseModelForValue.Value, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                </DockPanel>

                <DockPanel Grid.Row="1">
                    <Label Content="通用正极性调整" />
                    <ComboBox ItemsSource="{Binding BseModels}"
                              Margin="5, 0"
                              MinWidth="50"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding BseModelForPos}"
                              VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Text="关"
                                   VerticalAlignment="Center" />
                        <ToggleButton Margin="8,0,8,0"
                                      IsChecked="{Binding BseModelForPos.Positive, Mode=TwoWay}" />
                        <TextBlock Text="开"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <DockPanel Grid.Row="2">
                    <Label Content="通用负极性调整" />
                    <ComboBox ItemsSource="{Binding BseModels}"
                              Margin="5, 0"
                              MinWidth="50"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding BseModelForNeg}"
                              VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Text="关"
                                   VerticalAlignment="Center" />
                        <ToggleButton Margin="8,0,8,0"
                                      IsChecked="{Binding BseModelForNeg.Negative, Mode=TwoWay}" />
                        <TextBlock Text="开"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <ItemsControl Grid.Row="3"
                              ItemsSource="{Binding BseModels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <Label Content="{Binding Name}"
                                       Width="80"
                                       HorizontalContentAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left" />
                                <TextBox Text="{Binding Value, Mode=TwoWay}"
                                         MinWidth="60"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center"
                                         DockPanel.Dock="Right" />
                                <Slider Minimum="{Binding MinValue}"
                                        Maximum="{Binding MaxValue}"
                                        Value="{Binding Value, Mode=TwoWay}"
                                        VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <ItemsControl Grid.Column="0"
                                  ItemsSource="{Binding BseModels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="{Binding Name, StringFormat=正极_{0}}"
                                               Width="80"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Left" />
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="关"
                                                   VerticalAlignment="Center" />
                                        <ToggleButton Margin="8,0,8,0"
                                                      IsChecked="{Binding Positive}" />
                                        <TextBlock Text="开"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding BseModels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="{Binding Path=Name, StringFormat=负极_{0}}"
                                               Width="80"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Left" />
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="关"
                                                   VerticalAlignment="Center" />
                                        <ToggleButton Margin="8,0,8,0"
                                                      IsChecked="{Binding Negative}" />
                                        <TextBlock Text="开"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="SE">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <DockPanel LastChildFill="True"
                           Grid.Row="0">
                    <Label Content="设置数值"
                           Width="80"
                           HorizontalContentAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                    <TextBox Text="{Binding SeModel.Value, Mode=TwoWay}"
                             MinWidth="60"
                             HorizontalContentAlignment="Center"
                             VerticalAlignment="Center"
                             DockPanel.Dock="Right" />
                    <Slider Minimum="{Binding SeModel.MinValue}"
                            Maximum="{Binding SeModel.MaxValue}"
                            Value="{Binding SeModel.Value, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                </DockPanel>

                <DockPanel LastChildFill="True"
                           Grid.Row="1">
                    <Label Content="使能开关"
                           Width="80"
                           HorizontalContentAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
