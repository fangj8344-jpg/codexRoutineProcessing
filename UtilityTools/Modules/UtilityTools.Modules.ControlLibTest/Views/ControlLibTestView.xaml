                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                    <Button Content="获取"
                            Command="{Binding GetVacCommand}"
                            CommandParameter="3"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center" />
                    <TextBlock Text="{Binding VacModel.Value3}"
                               Margin="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </DockPanel>

                <DockPanel Grid.Row="3">
                    <Label Content="真空规CH4"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                    <Button Content="获取"
                            Command="{Binding GetVacCommand}"
                            CommandParameter="4"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center" />
                    <TextBlock Text="{Binding VacModel.Value4}"
                               Margin="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </DockPanel>

            </Grid>
        </TabItem>
        <TabItem Header="BSE">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Label Content="通用数值调整" />
                    <ComboBox ItemsSource="{Binding BseModels}"
                              Margin="5, 0"
                              MinWidth="50"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding BseModelForValue}"
                              VerticalAlignment="Center" />
                    <TextBox Text="{Binding BseModelForValue.Value, Mode=TwoWay}"
                             MinWidth="60"
                             HorizontalContentAlignment="Center"
                             VerticalAlignment="Center"
                             DockPanel.Dock="Right" />
                    <Slider Minimum="{Binding BseModelForValue.MinValue}"
                            Maximum="{Binding BseModelForValue.MaxValue}"
                            Value="{Binding BseModelForValue.Value, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                </DockPanel>

                <DockPanel Grid.Row="1">
                    <Label Content="通用正极性调整" />
                    <ComboBox ItemsSource="{Binding BseModels}"
                              Margin="5, 0"
                              MinWidth="50"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding BseModelForPos}"
                              VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Text="关"
                                   VerticalAlignment="Center" />
                        <ToggleButton Margin="8,0,8,0"
                                      IsChecked="{Binding BseModelForPos.Positive, Mode=TwoWay}" />
                        <TextBlock Text="开"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <DockPanel Grid.Row="2">
                    <Label Content="通用负极性调整" />
                    <ComboBox ItemsSource="{Binding BseModels}"
                              Margin="5, 0"
                              MinWidth="50"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding BseModelForNeg}"
                              VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Text="关"
                                   VerticalAlignment="Center" />
                        <ToggleButton Margin="8,0,8,0"
                                      IsChecked="{Binding BseModelForNeg.Negative, Mode=TwoWay}" />
                        <TextBlock Text="开"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <ItemsControl Grid.Row="3"
                              ItemsSource="{Binding BseModels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <Label Content="{Binding Name}"
                                       Width="80"
                                       HorizontalContentAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left" />
                                <TextBox Text="{Binding Value, Mode=TwoWay}"
                                         MinWidth="60"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center"
                                         DockPanel.Dock="Right" />
                                <Slider Minimum="{Binding MinValue}"
                                        Maximum="{Binding MaxValue}"
                                        Value="{Binding Value, Mode=TwoWay}"
                                        VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <ItemsControl Grid.Column="0"
                                  ItemsSource="{Binding BseModels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="{Binding Name, StringFormat=正极_{0}}"
                                               Width="80"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Left" />
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="关"
                                                   VerticalAlignment="Center" />
                                        <ToggleButton Margin="8,0,8,0"
                                                      IsChecked="{Binding Positive}" />
                                        <TextBlock Text="开"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding BseModels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="{Binding Path=Name, StringFormat=负极_{0}}"
                                               Width="80"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Left" />
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="关"
                                                   VerticalAlignment="Center" />
                                        <ToggleButton Margin="8,0,8,0"
                                                      IsChecked="{Binding Negative}" />
                                        <TextBlock Text="开"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="SE">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <DockPanel LastChildFill="True"
                           Grid.Row="0">
                    <Label Content="设置数值"
                           Width="80"
                           HorizontalContentAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                    <TextBox Text="{Binding SeModel.Value, Mode=TwoWay}"
                             MinWidth="60"
                             HorizontalContentAlignment="Center"
                             VerticalAlignment="Center"
                             DockPanel.Dock="Right" />
                    <Slider Minimum="{Binding SeModel.MinValue}"
                            Maximum="{Binding SeModel.MaxValue}"
                            Value="{Binding SeModel.Value, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                </DockPanel>

                <DockPanel LastChildFill="True"
                           Grid.Row="1">
                    <Label Content="使能开关"
                           Width="80"
                           HorizontalContentAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Text="关"
                                   VerticalAlignment="Center" />
                        <ToggleButton Margin="8,0,8,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding SeModel.Enable}" />
                        <TextBlock Text="开"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </TabItem>
