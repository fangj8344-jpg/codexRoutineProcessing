<UserControl x:Class="UtilityTools.Modules.FDC12CHVBox.Views.FDC12CHVBoxContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mm="clr-namespace:UtilityTools.Modules.FDC12CHVBox.Model"
             xmlns:convert="clr-namespace:UtilityTools.Modules.FDC12CHVBox.Converter"
             xmlns:rules="clr-namespace:UtilityTools.Modules.FDC12CHVBox.Rule"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:local="clr-namespace:UtilityTools.Modules.FDC12CHVBox.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <convert:StatusToColorConverter x:Key="StatusToColorConverter"/>
    </UserControl.Resources>
    <TabControl>
        <TabItem Header="控制">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <DockPanel LastChildFill="False" >
                        <TextBlock Text="RemoteIp"    DockPanel.Dock="Left" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBox Text="{Binding LocalIp }" BorderThickness="0,0,0,2"  Margin="5" DockPanel.Dock="Left" BorderBrush="#CCCCCC" Padding="5,2" MinWidth="120"  VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <TextBlock Text="LocalPortStart"   DockPanel.Dock="Left" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                       
                        <TextBox Text="{Binding RemoteIp }" BorderThickness="0,0,0,2"  Margin="5" DockPanel.Dock="Left" BorderBrush="#CCCCCC" Padding="5,2" MinWidth="120"  VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <TextBlock Text="RemotePort"    DockPanel.Dock="Left" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBox Text="{Binding RemotePort}" BorderThickness="0,0,0,2"   Margin="5" DockPanel.Dock="Left" BorderBrush="#CCCCCC" Padding="5,2" MinWidth="100"  VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <Button Content="Connect" Command="{Binding ConnectCommand}"  Margin="5" />
                        <Button Content="测试" Command="{Binding TestCommand}"/>
                    </DockPanel>
                    <DockPanel LastChildFill="False" Grid.Row="1" >
                        <TextBlock  Text="全选"  DockPanel.Dock="Left" Margin="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding IsAllCheck,Mode=TwoWay}" Command="{Binding IsAllCheckChangeCommand}"  Margin="5"/>
                        <TextBlock  Text="同步需求"  DockPanel.Dock="Left" Margin="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBox  BorderThickness="0,0,0,2"  DockPanel.Dock="Left" BorderBrush="#CCCCCC" Padding="5,2" MinWidth="60" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Center" >
                            <TextBox.Text>
                                <Binding Path="WriteHv" UpdateSourceTrigger="PropertyChanged" Mode="TwoWay" >
                                    <Binding.ValidationRules>
                                        <rules:RangeValidationRule Min="0" Max="30000"/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                            <TextBox.InputBindings>
                                <KeyBinding  Key="Return"  Command="{Binding SetHvCommand }"  />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="V" DockPanel.Dock="Left" Margin="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button Content="set" Command="{Binding SetHvCommand}" Margin="5" />
                        <TextBlock  Text="速率"  DockPanel.Dock="Left" Margin="10,5,5,5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBox  BorderThickness="0,0,0,2"  DockPanel.Dock="Left" BorderBrush="#CCCCCC" Padding="5,2" MinWidth="60" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Center" >
                            <TextBox.Text>
                                <Binding Path="WriteAllStep" UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                                    <Binding.ValidationRules>
                                        <rules:RangeValidationRule Min="5" Max="500"/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                            <TextBox.InputBindings>
                                <KeyBinding  Key="Return"  Command="{Binding SetHvStepCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                       
                        <TextBlock Text="V" DockPanel.Dock="Left" Margin="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button Content="set" Command="{Binding SetHvStepCommand}" />
                        <TextBlock  Text="{Binding SetStep}"   DockPanel.Dock="Left" Margin="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button Content="关闭输出" Command="{Binding CloseOutPutCommand}" Margin="5" DockPanel.Dock="Right"/>
                    </DockPanel>
                </StackPanel>
                <ScrollViewer  Grid.Row="2" Height="auto"  HorizontalScrollBarVisibility="Auto"   VerticalScrollBarVisibility="Auto"  Width="auto"  >
                    <ItemsControl ItemsSource="{Binding HVBoxModels}"  >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type mm:HVBoxModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Channel, StringFormat='通道号:{0:00}'}"  
                                               Width="100" DockPanel.Dock="Left" Margin="1" 
                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <DockPanel  Grid.Row="1" LastChildFill="False">
                                        <CheckBox IsChecked="{Binding IsCheck,Mode=TwoWay}" MinWidth="20" Margin="5,0,40,0"/>
                                        <Button Width="20" Height="20"
                                                    Background="{Binding HVBoxInitState, Converter={StaticResource StatusToColorConverter}}"
                                                    Command="{Binding SetHvInitCommand}"/>
                                    </DockPanel>
                                    <DockPanel LastChildFill="False" Grid.Column="1" >
                                        <TextBlock  Text="需求"  
                                                    DockPanel.Dock="Left" Margin="1" 
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBox BorderThickness="0,0,0,2"  
                                                 DockPanel.Dock="Left" BorderBrush="#CCCCCC" Padding="5,2"
                                                 MinWidth="60" Margin="5" 
                                                 VerticalAlignment="Center" HorizontalAlignment="Center" >
                                            <TextBox.Text>
                                                <Binding Path="WriteHV" UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                                                    <Binding.ValidationRules>
                                                        <rules:RangeValidationRule Min="0" Max="30000"/>
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                            <TextBox.InputBindings>
                                                <KeyBinding  Key="Return"  Command="{Binding SetHvCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock Text="V" DockPanel.Dock="Left" 
                                                   Margin="1" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <Button Content="set" Command="{Binding SetHvCommand}" Margin="5" IsEnabled="{Binding IsEnable}"/>
                                        <TextBlock  Text="{Binding SetHV}"   
                                                    DockPanel.Dock="Left" Margin="5"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DockPanel>
                                    <DockPanel LastChildFill="False" Grid.Column="1" Grid.Row="1">
                                        <TextBlock  Text="速率"  DockPanel.Dock="Left" Margin="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBox BorderThickness="0,0,0,2"  DockPanel.Dock="Left" BorderBrush="#CCCCCC" 
                                                 Padding="5,2" MinWidth="60" Margin="5" 
                                                 VerticalAlignment="Center" HorizontalAlignment="Center" >
                                            <TextBox.Text>
                                                <Binding   Path="WriteStep" UpdateSourceTrigger="PropertyChanged" Mode="TwoWay"   >
                                                    <Binding.ValidationRules>
                                                        <rules:RangeValidationRule Min="5" Max="500"/>
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                            <TextBox.InputBindings>
                                                <KeyBinding  Key="Return"  Command="{Binding SetHvStepCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock Text="V" DockPanel.Dock="Left" Margin="1" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <Button Content="set" Command="{Binding SetHvStepCommand}" Margin="5"/>
                                        <TextBlock  Text="{Binding SetStep}"   DockPanel.Dock="Left" Margin="5" 
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DockPanel>
                                    <DockPanel LastChildFill="False" Grid.Column="2" Grid.Row="2" Grid.RowSpan="2">
                                        <TextBlock Text="{Binding ReadHV, StringFormat={}{0:F3} V}" 
                                                   FontSize="20" FontWeight="Black"  DockPanel.Dock="Left" Margin="5" 
                                                   VerticalAlignment="Top" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding ReadI, StringFormat={}{0:F3} μA}"
                                                   FontSize="20" FontWeight="Black" DockPanel.Dock="Left" Margin="5" 
                                                   VerticalAlignment="Top" HorizontalAlignment="Center"/>
                                    </DockPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <TabItem Header="图表">
            <oxy:PlotView Model="{Binding PlotModel}"   Foreground="Black" Background="LightGray">
                <oxy:PlotView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="自适应"
                        Command="{Binding AutoAdjustCommand}"  />
                        <MenuItem Header="清除"
                        Command="{Binding ClearMonitorCommand}"  />
                        <MenuItem Header="导出为csv文件"
                        Command="{Binding ExportMultipleSeriesToCsvCommand}" />
                    </ContextMenu>
                </oxy:PlotView.ContextMenu>
            </oxy:PlotView>
        </TabItem>
    </TabControl>
</UserControl>

