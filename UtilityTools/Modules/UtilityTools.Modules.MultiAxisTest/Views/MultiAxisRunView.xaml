<UserControl
    x:Class="UtilityTools.Modules.MultiAxisTest.Views.MultiAxisRunView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:UtilityTools.Core.Converter;assembly=UtilityTools.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:modelMt="clr-namespace:UtilityTools.Modules.MotorTest.Model;assembly=UtilityTools.Modules.MotorTest"
    xmlns:mtViews="clr-namespace:UtilityTools.Modules.MotorTest.Views;assembly=UtilityTools.Modules.MotorTest"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="768"
    d:DesignWidth="1280"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Focusable="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <cv:BoolToColorConverter x:Key="BoolToColorConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding
            Key="L"
            Command="{Binding OpenEngineerConfigCommand}"
            Modifiers="Ctrl" />
    </UserControl.InputBindings>

    <md:DialogHost DialogTheme="Inherit" Identifier="MultiAxisRunViewHost">
        <Grid Background="{DynamicResource MaterialDesignPaper}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel
                Grid.Row="0"
                Margin="10,10,10,0"
                LastChildFill="False">

                <Button
                    Width="36"
                    Height="36"
                    Padding="0"
                    Command="{Binding ExecuteGoBackCommand}"
                    DockPanel.Dock="Left"
                    Foreground="Gray"
                    Style="{StaticResource MaterialDesignToolForegroundButton}"
                    ToolTip="返回扫码识别页">
                    <md:PackIcon
                        Width="24"
                        Height="24"
                        Kind="ArrowLeft" />
                </Button>

                <Button
                    Height="32"
                    Margin="0,0,5,0"
                    Padding="12,0"
                    md:ButtonAssist.CornerRadius="4"
                    IsEnabled="{Binding CanUpload}"
                    Background="#4CAF50"
                    BorderBrush="#4CAF50"
                    Command="{Binding UploadDataCommand}"
                    DockPanel.Dock="Right"
                    Foreground="White"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    ToolTip="所有轴基础测试通过后方可提交数据">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Kind="CloudUpload" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Text="提交测试数据" />
                    </StackPanel>
                </Button>

                <Button
                    Height="32"
                    Margin="0,0,5,0"
                    Padding="12,0"
                    md:ButtonAssist.CornerRadius="4"
                    Background="#FF9800"
                    BorderBrush="#FF9800"
                    Command="{Binding FillMockMotorDataCommand}"
                    DockPanel.Dock="Right"
                    Foreground="White"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    ToolTip="填充虚拟电机测试数据（仅调试用）"
                    Visibility="{Binding IsDevShortcutMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Kind="DatabasePlus" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Text="填充假数据" />
                    </StackPanel>
                </Button>


            </DockPanel>

            <Grid Grid.Row="1" Margin="0,5,0,0">
                <mtViews:ThreeAxisTestModelWindowsView Margin="0" />
            </Grid>

            <StatusBar Grid.Row="2"
                       Background="{DynamicResource PrimaryHueLightBrush}"
                       Foreground="{DynamicResource PrimaryHueLightForegroundBrush}">
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="FW 当前: " Opacity="0.85" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding FirmwareCurrentVersion}" />
                    </StackPanel>
                </StatusBarItem>
                <Separator Style="{StaticResource MaterialDesignLightSeparator}" />
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="最新: " Opacity="0.85" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding FirmwareLatestVersion}" />
                    </StackPanel>
                </StatusBarItem>
                <Separator Style="{StaticResource MaterialDesignLightSeparator}" />
                <StatusBarItem>
                    <TextBlock FontWeight="SemiBold"
                               Opacity="0.95"
                               Text="{Binding FirmwareStatusText}" />
                </StatusBarItem>
            </StatusBar>

        </Grid>
    </md:DialogHost>
</UserControl>