<UserControl x:Class="UtilityTools.Modules.MultiAxisTest.Views.EngineerConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UtilityTools.Modules.MultiAxisTest.Views"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="14"
             FontFamily="微软雅黑"
             Background="{DynamicResource MaterialDesignPaper}">
    <ScrollViewer Padding="20">
        <StackPanel MaxWidth="600" Margin="0,10,0,0">

            <TextBlock Text="工程师配置中心" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource PrimaryHueMidBrush}"/>

            <md:Card Padding="20" Margin="0,0,0,20" UniformCornerRadius="8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <md:PackIcon Kind="Devices" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="设备标识配置" FontWeight="Bold" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBox md:HintAssist.Hint="设备唯一 ID (Device ID)"
                             md:TextFieldAssist.HasClearButton="True"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             Text="{Binding DeviceId, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" FontSize="15"/>
                </StackPanel>
            </md:Card>

            <md:Card Padding="20" Margin="0,0,0,20" UniformCornerRadius="8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <md:PackIcon Kind="ShieldAccount" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="服务器授权认证" FontWeight="Bold" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox md:HintAssist.Hint="服务器地址"
                             md:TextFieldAssist.HasClearButton ="true"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,20" FontSize="15"/>

                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" 
                                 md:HintAssist.Hint="认证账号 (Username)"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10" FontSize="15"/>

                        <PasswordBox Grid.Column="2" 
                                     md:HintAssist.Hint="认证密码 (Password)"
                                     Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                     md:PasswordBoxAssist.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10" FontSize="15"/>
                    </Grid>

                    <Button Command="{Binding GetTokenCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,20,0,0" HorizontalAlignment="Right" Width="140">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="KeyChain" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="请求授权令牌" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Separator Margin="0,20" Background="{DynamicResource MaterialDesignDivider}"/>

                    <md:ColorZone Mode="Standard" CornerRadius="4" Padding="15" 
                                  Background="{DynamicResource MaterialDesignToolBarBackground}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <md:PackIcon Grid.Column="0" Kind="{Binding TokenStatusIcon}" 
                                         Foreground="{Binding TokenStatusColor}" 
                                         Width="32" Height="32" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TokenStatusText}" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="{Binding ExpireTimeString}" FontSize="12" Opacity="0.7" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </md:ColorZone>
                </StackPanel>
            </md:Card>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,20">
                <Button Content="重置" Style="{StaticResource MaterialDesignFlatButton}" 
                        Command="{Binding ResetCommand}" Margin="0,0,10,0"/>

                <Button Command="{Binding SaveConfigCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Width="120">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ContentSave" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="保存配置" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="关闭" 
                        Command="{x:Static md:DialogHost.CloseDialogCommand}" 
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="10,0,10,0"/> 
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
