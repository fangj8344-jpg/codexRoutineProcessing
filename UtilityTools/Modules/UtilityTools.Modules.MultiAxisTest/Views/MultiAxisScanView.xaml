<UserControl
    x:Class="UtilityTools.Modules.MultiAxisTest.Views.MultiAxisScanView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    prism:ViewModelLocator.AutoWireViewModel="True"
    InputMethod.IsInputMethodEnabled="False"
    mc:Ignorable="d">

    <UserControl.InputBindings>
        <KeyBinding
            Key="L"
            Command="{Binding OpenEngineerConfigCommand}"
            Modifiers="Ctrl" />
    </UserControl.InputBindings>

    <md:DialogHost DialogTheme="Inherit" Identifier="MultiAxisScanViewHost">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,20"
                Orientation="Horizontal">
                <md:PackIcon
                    Width="36"
                    Height="36"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                    Kind="BarcodeScan" />
                <TextBlock
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                    Text="样品台扫码自动识别" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="6*" />
                </Grid.ColumnDefinitions>

                <md:Card
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    Padding="24"
                    md:ElevationAssist.Elevation="Dp2"
                    UniformCornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,20"
                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                            Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                            Text="当前解析详情" />

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <md:PackIcon
                                Grid.Row="0"
                                Width="22"
                                Height="22"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Kind="Devices" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Text="电镜型号" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{Binding State.CurrentScanDisplay.ElectronMicroscopeModel}" />

                            <md:PackIcon
                                Grid.Row="1"
                                Width="22"
                                Height="22"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Kind="TableSettings" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Text="样品台型号" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{Binding State.CurrentScanDisplay.StageType}" />

                            <md:PackIcon
                                Grid.Row="2"
                                Width="22"
                                Height="22"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Kind="CartOutline" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Text="采购订单号" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{Binding State.CurrentScanDisplay.PurchaseOrder}" />

                            <md:PackIcon
                                Grid.Row="3"
                                Width="22"
                                Height="22"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Kind="Factory" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Text="生产订单号" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{Binding State.CurrentScanDisplay.ProductionOrder}" />

                            <md:PackIcon
                                Grid.Row="4"
                                Width="22"
                                Height="22"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Kind="AccountHardHat" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Text="操作员工号" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{Binding State.CurrentScanDisplay.OperatorId}" />

                            <md:PackIcon
                                Grid.Row="5"
                                Width="22"
                                Height="22"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Kind="CalendarClock" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Text="生产日期" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{Binding State.CurrentScanDisplay.ProductionDate}" />

                            <md:PackIcon
                                Grid.Row="6"
                                Width="22"
                                Height="22"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource SecondaryHueMidBrush}"
                                Kind="Barcode" />
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Text="序列号" />
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="{DynamicResource SecondaryHueMidBrush}"
                                Text="{Binding State.CurrentScanDisplay.SerialNumber}" />
                        </Grid>
                    </StackPanel>
                </md:Card>
                <md:Card
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Padding="0"
                    md:ElevationAssist.Elevation="Dp2"
                    UniformCornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="24,24,24,10"
                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                            Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                            Text="数据溯源与详情" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Border Padding="24,0,24,24">
                                <StackPanel>
                                    <TextBox
                                        md:HintAssist.Hint="原始扫码文本"
                                        md:HintAssist.IsFloating="True"
                                        BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                                        FontSize="14"
                                        Foreground="{DynamicResource MaterialDesignBody}"
                                        IsReadOnly="True"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding State.CurrentScanText}"
                                        TextWrapping="Wrap" />

                                    <Grid Margin="0,16,0,0">
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding CloudCheckingVisibility}">
                                            <ProgressBar
                                                Width="18"
                                                Height="18"
                                                Margin="0,0,8,0"
                                                IsIndeterminate="True"
                                                Style="{StaticResource MaterialDesignCircularProgressBar}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Opacity="0.6"
                                                Text="正在同步云端标定数据..." />
                                        </StackPanel>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{Binding CloudResultColor}"
                                            Text="{Binding CloudResultText}"
                                            Visibility="{Binding CloudResultVisibility}" />
                                    </Grid>

                                    <Border
                                        Margin="0,12,0,0"
                                        Padding="16"
                                        Background="#212121"
                                        BorderBrush="#333"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock
                                                Margin="0,0,0,10"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource PrimaryHueLightBrush}"
                                                Text="云端溯源详情 (JSON数据)" />

                                            <ItemsControl ItemsSource="{Binding CloudContentFields}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                FontSize="12"
                                                                Foreground="#888"
                                                                Text="{Binding Label}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                HorizontalAlignment="Right"
                                                                Foreground="White"
                                                                Text="{Binding Value}"
                                                                TextAlignment="Right"
                                                                TextWrapping="Wrap" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Separator Margin="0,12" Background="#333" />

                                            <TextBlock
                                                Margin="0,0,0,8"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource PrimaryHueLightBrush}"
                                                Text="电机轴标定参数" />
                                            <ItemsControl ItemsSource="{Binding CloudMotors}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Margin="0,4"
                                                            Padding="10"
                                                            Background="#2D2D2D"
                                                            CornerRadius="4">
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <TextBlock
                                                                        FontWeight="Bold"
                                                                        Foreground="{DynamicResource SecondaryHueMidBrush}"
                                                                        Text="{Binding AxisType}" />
                                                                    <TextBlock
                                                                        HorizontalAlignment="Right"
                                                                        FontSize="11"
                                                                        Foreground="#4CAF50"
                                                                        Text="{Binding PrecisionStd}" />
                                                                </DockPanel>

                                                                <UniformGrid Margin="0,8,0,0" Columns="2">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock
                                                                            FontSize="11"
                                                                            Foreground="#666"
                                                                            Text="范围: " />
                                                                        <TextBlock
                                                                            FontSize="11"
                                                                            Foreground="#DDD"
                                                                            Text="{Binding MinRange}" />
                                                                        <TextBlock
                                                                            FontSize="11"
                                                                            Foreground="#DDD"
                                                                            Text="~" />
                                                                        <TextBlock
                                                                            FontSize="11"
                                                                            Foreground="#DDD"
                                                                            Text="{Binding MaxRange}" />
                                                                    </StackPanel>
                                                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                                        <TextBlock
                                                                            FontSize="11"
                                                                            Foreground="#666"
                                                                            Text="限位: " />
                                                                        <TextBlock
                                                                            FontSize="11"
                                                                            Foreground="#DDD"
                                                                            Text="{Binding NegLimit}" />
                                                                        <TextBlock
                                                                            FontSize="11"
                                                                            Foreground="#DDD"
                                                                            Text="/" />
                                                                        <TextBlock
                                                                            FontSize="11"
                                                                            Foreground="#DDD"
                                                                            Text="{Binding PosLimit}" />
                                                                    </StackPanel>
                                                                </UniformGrid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </md:Card>
            </Grid>
            <StackPanel
                Grid.Row="2"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="250"
                    Height="50"
                    md:ButtonAssist.CornerRadius="25"
                    Command="{Binding ConfirmCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon
                            Width="24"
                            Height="24"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Kind="PlayCircleOutline" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="确认信息并进入测试" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </md:DialogHost>
</UserControl>