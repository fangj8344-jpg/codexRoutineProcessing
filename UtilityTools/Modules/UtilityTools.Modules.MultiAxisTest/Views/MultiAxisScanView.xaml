<UserControl
    x:Class="UtilityTools.Modules.MultiAxisTest.Views.MultiAxisScanView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    prism:ViewModelLocator.AutoWireViewModel="True"
    InputMethod.IsInputMethodEnabled="False"
    mc:Ignorable="d">

    <UserControl.InputBindings>
        <KeyBinding
            Key="L"
            Command="{Binding OpenEngineerConfigCommand}"
            Modifiers="Ctrl" />
    </UserControl.InputBindings>

    <md:DialogHost DialogTheme="Inherit" Identifier="MultiAxisScanViewHost">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,20"
                Orientation="Horizontal">
                <md:PackIcon
                    Width="36"
                    Height="36"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                    Kind="BarcodeScan" />
                <TextBlock
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                    Text="样品台扫码自动识别" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="6*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <md:Card
                            Padding="20"
                            md:ElevationAssist.Elevation="Dp2"
                            UniformCornerRadius="8">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,16"
                                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                                    Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                    Text="当前解析详情" />

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <md:PackIcon Grid.Row="0" Width="20" Height="20" VerticalAlignment="Center" Foreground="Gray" Kind="Devices" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Foreground="Gray" Text="电镜型号" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding State.CurrentScanDisplay.ElectronMicroscopeModel}" />

                                    <md:PackIcon Grid.Row="1" Width="20" Height="20" VerticalAlignment="Center" Foreground="Gray" Kind="TableSettings" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Foreground="Gray" Text="样品台型号" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding State.CurrentScanDisplay.StageType}" />

                                    <md:PackIcon Grid.Row="2" Width="20" Height="20" VerticalAlignment="Center" Foreground="Gray" Kind="CartOutline" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Foreground="Gray" Text="采购订单号" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding State.CurrentScanDisplay.PurchaseOrder}" />

                                    <md:PackIcon Grid.Row="3" Width="20" Height="20" VerticalAlignment="Center" Foreground="Gray" Kind="Factory" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Foreground="Gray" Text="生产订单号" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding State.CurrentScanDisplay.ProductionOrder}" />

                                    <md:PackIcon Grid.Row="4" Width="20" Height="20" VerticalAlignment="Center" Foreground="Gray" Kind="AccountHardHat" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Foreground="Gray" Text="操作员工号" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding State.CurrentScanDisplay.OperatorId}" />

                                    <md:PackIcon Grid.Row="5" Width="20" Height="20" VerticalAlignment="Center" Foreground="Gray" Kind="CalendarClock" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Foreground="Gray" Text="生产日期" />
                                    <TextBlock Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding State.CurrentScanDisplay.ProductionDate}" />

                                    <md:PackIcon Grid.Row="6" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryHueMidBrush}" Kind="Barcode" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Foreground="Gray" Text="序列号" />
                                    <TextBlock Grid.Row="6" Grid.Column="2" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SecondaryHueMidBrush}" Text="{Binding State.CurrentScanDisplay.SerialNumber}" />
                                </Grid>
                            </StackPanel>
                        </md:Card>
                    </StackPanel>

                    <md:Card
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        Padding="0"
                        Background="#2A2A2A"
                        md:ElevationAssist.Elevation="Dp2"
                        UniformCornerRadius="8"
                        Visibility="{Binding ThresholdPanelVisibility}">
                        <Expander
                            IsExpanded="True"
                            Padding="12"
                            Background="Transparent"
                            Foreground="{DynamicResource MaterialDesignBody}">
                            <Expander.Header>
                                <DockPanel LastChildFill="False">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource PrimaryHueLightBrush}"
                                        Text="测试标准（按样品台）" />
                                    <TextBlock
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="#9E9E9E"
                                        Text="{Binding ThresholdStageTypeDisplay, StringFormat=当前型号：{0}}" />
                                </DockPanel>
                            </Expander.Header>

                            <ScrollViewer
                                Margin="0,8,0,0"
                                MaxHeight="270"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBox Grid.Row="0" Grid.Column="0" Margin="0,0,0,8" md:HintAssist.Hint="移动测试最小位移(脉冲)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding MovementMinDistancePulseText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Row="0" Grid.Column="2" Margin="0,0,0,8" md:HintAssist.Hint="编码器最小变化(脉冲)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding EncoderMinDeltaPulseText, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,0,8" md:HintAssist.Hint="限位精度最大偏差(脉冲)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding LimitAccuracyMaxDiffPulseText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Row="1" Grid.Column="2" Margin="0,0,0,8" md:HintAssist.Hint="线性测试标准差上限(um)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding LinearStdDevMaxUmText, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBox Grid.Row="2" Grid.Column="0" Margin="0,0,0,8" md:HintAssist.Hint="顺滑度标准差上限(um)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding SmoothnessStdDevMaxUmText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Row="2" Grid.Column="2" Margin="0,0,0,8" md:HintAssist.Hint="满行程最小值(脉冲)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding FullTravelMinPulseText, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBox Grid.Row="3" Grid.Column="0" Margin="0,0,0,8" md:HintAssist.Hint="满行程最大值(脉冲)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding FullTravelMaxPulseText, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBox Grid.Row="4" Grid.Column="0" Margin="0,0,0,8" md:HintAssist.Hint="X轴行程最小值(脉冲)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding XFullTravelMinPulseText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Row="4" Grid.Column="2" Margin="0,0,0,8" md:HintAssist.Hint="X轴行程最大值(脉冲)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding XFullTravelMaxPulseText, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBox Grid.Row="5" Grid.Column="0" Margin="0,0,0,8" md:HintAssist.Hint="Y轴行程最小值(脉冲)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding YFullTravelMinPulseText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Row="5" Grid.Column="2" Margin="0,0,0,8" md:HintAssist.Hint="Y轴行程最大值(脉冲)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding YFullTravelMaxPulseText, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <DockPanel Margin="0,6,0,0">
                                        <Button
                                            Width="130"
                                            Height="32"
                                            Command="{Binding SaveThresholdConfigCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Width="16" Height="16" Margin="0,0,6,0" Kind="ContentSaveOutline" />
                                                <TextBlock Text="保存" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding ThresholdSaveMessageColor}"
                                            Text="{Binding ThresholdSaveMessage}" />
                                    </DockPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>
                    </md:Card>

                    <md:Card
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        Padding="14"
                        md:ElevationAssist.Elevation="Dp1"
                        UniformCornerRadius="8"
                        Visibility="{Binding ThresholdPlaceholderVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon
                                Width="20"
                                Height="20"
                                Margin="0,0,8,0"
                                Foreground="#9E9E9E"
                                Kind="BarcodeScan" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="#9E9E9E"
                                Text="请先扫码，识别样品台后显示测试标准配置面板" />
                        </StackPanel>
                    </md:Card>
                </Grid>
                <md:Card
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Padding="0"
                    md:ElevationAssist.Elevation="Dp2"
                    UniformCornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="24,24,24,10"
                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                            Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                            Text="数据溯源与详情" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Border Padding="24,0,24,24">
                                <StackPanel>
                                    <TextBox
                                        Margin="0,12,0,0"
                                        md:HintAssist.Hint="原始扫码文本"
                                        md:HintAssist.IsFloating="True"
                                        BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                                        FontSize="14"
                                        Foreground="{DynamicResource MaterialDesignBody}"
                                        IsReadOnly="True"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding State.CurrentScanText}"
                                        TextWrapping="Wrap" />

                                    <Grid Margin="0,16,0,0">
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding CloudCheckingVisibility}">
                                            <ProgressBar
                                                Width="18"
                                                Height="18"
                                                Margin="0,0,8,0"
                                                IsIndeterminate="True"
                                                Style="{StaticResource MaterialDesignCircularProgressBar}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Opacity="0.6"
                                                Text="正在同步云端标定数据..." />
                                        </StackPanel>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{Binding CloudResultColor}"
                                            Text="{Binding CloudResultText}"
                                            Visibility="{Binding CloudResultVisibility}" />
                                    </Grid>

                                    <Border
                                        Margin="0,12,0,0"
                                        Padding="16"
                                        Background="#212121"
                                        BorderBrush="#333"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock
                                                Margin="0,0,0,10"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource PrimaryHueLightBrush}"
                                                Text="云端溯源详情 (JSON数据)" />

                                            <TextBlock
                                                Margin="0,0,0,8"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource PrimaryHueLightBrush}"
                                                Text="电机轴标定参数与误差表" />
                                            <ItemsControl ItemsSource="{Binding CloudMotors}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Margin="0,4"
                                                            Padding="12"
                                                            Background="#2D2D2D"
                                                            BorderBrush="#444"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                            <StackPanel>
                                                                <TextBlock
                                                                    FontSize="14"
                                                                    FontWeight="Bold"
                                                                    Foreground="{DynamicResource SecondaryHueMidBrush}"
                                                                    Text="{Binding AxisType}" />

                                                                <UniformGrid Margin="0,10,0,10" Columns="2">
                                                                    <StackPanel Margin="0,2" Orientation="Horizontal">
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            Foreground="#888"
                                                                            Text="范围(um): " />
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            Foreground="#DDD"
                                                                            Text="{Binding MinRange}" />
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            Foreground="#DDD"
                                                                            Text=" ~ " />
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            Foreground="#DDD"
                                                                            Text="{Binding MaxRange}" />
                                                                    </StackPanel>

                                                                    <StackPanel Margin="0,2" Orientation="Horizontal">
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            Foreground="#888"
                                                                            Text="软/硬限位: " />
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            Foreground="#DDD"
                                                                            Text="{Binding NegLimit}" />
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            Foreground="#DDD"
                                                                            Text=" / " />
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            Foreground="#DDD"
                                                                            Text="{Binding PosLimit}" />
                                                                    </StackPanel>

                                                                    <StackPanel Margin="0,2" Orientation="Horizontal">
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            Foreground="#888"
                                                                            Text="正向速度Std(um): " />
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            Foreground="#DDD"
                                                                            Text="{Binding ForwardStd}" />
                                                                    </StackPanel>

                                                                    <StackPanel Margin="0,2" Orientation="Horizontal">
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            Foreground="#888"
                                                                            Text="反向速度Std(um): " />
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            Foreground="#DDD"
                                                                            Text="{Binding ReverseStd}" />
                                                                    </StackPanel>

                                                                    <StackPanel Margin="0,2" Orientation="Horizontal">
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            Foreground="#888"
                                                                            Text="精度Std(um): " />
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            FontWeight="SemiBold"
                                                                            Foreground="#4CAF50"
                                                                            Text="{Binding PrecisionStd}" />
                                                                    </StackPanel>
                                                                </UniformGrid>

                                                                <Expander
                                                                    Padding="0"
                                                                    Background="Transparent"
                                                                    Foreground="#AAA">
                                                                    <Expander.Header>
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            FontWeight="SemiBold"
                                                                            Text="{Binding ErrorPoints.Count, StringFormat='查看定位精度误差表 ({0} 个采样点)'}" />
                                                                    </Expander.Header>
                                                                    <DataGrid
                                                                        MaxHeight="250"
                                                                        Margin="0,8,0,0"
                                                                        AlternatingRowBackground="#1E1E1E"
                                                                        AutoGenerateColumns="False"
                                                                        Background="#1E1E1E"
                                                                        BorderBrush="#444"
                                                                        BorderThickness="1"
                                                                        CanUserAddRows="False"
                                                                        Foreground="#CCC"
                                                                        GridLinesVisibility="Horizontal"
                                                                        HeadersVisibility="Column"
                                                                        HorizontalGridLinesBrush="#333"
                                                                        IsReadOnly="True"
                                                                        ItemsSource="{Binding ErrorPoints}"
                                                                        RowBackground="#252525">
                                                                        <DataGrid.Columns>
                                                                            <DataGridTextColumn
                                                                                Width="*"
                                                                                Binding="{Binding TargetUm}"
                                                                                Header="目标位置(um)" />
                                                                            <DataGridTextColumn
                                                                                Width="*"
                                                                                Binding="{Binding ActualUm}"
                                                                                Header="实际位置(um)" />
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>
                                                                </Expander>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </md:Card>
            </Grid>
            <StackPanel
                Grid.Row="2"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="250"
                    Height="50"
                    md:ButtonAssist.CornerRadius="25"
                    Command="{Binding ConfirmCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon
                            Width="24"
                            Height="24"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Kind="PlayCircleOutline" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="确认信息并进入测试" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </md:DialogHost>
</UserControl>