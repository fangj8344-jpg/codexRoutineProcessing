<UserControl
    x:Class="UtilityTools.Modules.MultiAxisTest.Views.MultiAxisScanView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="550"
    d:DesignWidth="1000"
    prism:ViewModelLocator.AutoWireViewModel="True"
    InputMethod.IsInputMethodEnabled="False"
    mc:Ignorable="d">

    <md:DialogHost DialogTheme="Inherit" Identifier="MultiAxisScanViewHost">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,20"
                Orientation="Horizontal">
                <md:PackIcon
                    Width="36"
                    Height="36"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                    Kind="BarcodeScan" />
                <TextBlock
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                    Text="样品台扫码自动识别" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <md:Card
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    Padding="24"
                    md:ElevationAssist.Elevation="Dp2"
                    UniformCornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,20"
                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                            Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                            Text="解析详情" />

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <md:PackIcon
                                Grid.Row="0"
                                Grid.Column="0"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Kind="CalendarClockOutline" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="Gray"
                                Text="电镜型号" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding State.CurrentScanDisplay.ElectronMicroscopeModel}" />

                            <md:PackIcon
                                Grid.Row="1"
                                Grid.Column="0"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Kind="CalendarClockOutline" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="Gray"
                                Text="样品台型号" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding State.CurrentScanDisplay.StageType}" />

                            <md:PackIcon
                                Grid.Row="2"
                                Grid.Column="0"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Kind="CartOutline" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="Gray"
                                Text="采购订单号" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding State.CurrentScanDisplay.PurchaseOrder}" />

                            <md:PackIcon
                                Grid.Row="3"
                                Grid.Column="0"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Kind="Factory" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="Gray"
                                Text="生产订单号" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding State.CurrentScanDisplay.ProductionOrder}" />

                            <md:PackIcon
                                Grid.Row="4"
                                Grid.Column="0"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Kind="AccountHardHat" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="Gray"
                                Text="操作 / 检验员工号" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding State.CurrentScanDisplay.OperatorId}" />

                            <md:PackIcon
                                Grid.Row="5"
                                Grid.Column="0"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Kind="CalendarClockOutline" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="Gray"
                                Text="生产日期" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding State.CurrentScanDisplay.ProductionDate}" />

                            <md:PackIcon
                                Grid.Row="6"
                                Grid.Column="0"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Kind="Barcode" />
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="Gray"
                                Text="序列号" />
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource SecondaryHueMidBrush}"
                                Text="{Binding State.CurrentScanDisplay.SerialNumber}" />

                        </Grid>
                    </StackPanel>
                </md:Card>

                <md:Card
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Padding="24"
                    md:ElevationAssist.Elevation="Dp2"
                    UniformCornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,20"
                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                            Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                            Text="原始扫码数据" />

                        <TextBox
                            Height="100"
                            Margin="0,10,0,0"
                            md:HintAssist.Hint="请使用扫码枪扫描条码..."
                            md:HintAssist.IsFloating="True"
                            Focusable="False"
                            FontSize="16"
                            IsReadOnly="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding State.CurrentScanText}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />

                        <StackPanel
                            Margin="0,20,0,0"
                            HorizontalAlignment="Center"
                            Opacity="0.6"
                            Orientation="Horizontal">
                            <md:PackIcon
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Kind="InformationOutline" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Text="请确保输入法处于纯英文状态" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,16,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding CloudCheckingVisibility}">
                            <ProgressBar
                                Width="18"
                                Height="18"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                IsIndeterminate="True"
                                Style="{StaticResource MaterialDesignCircularProgressBar}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Opacity="0.6"
                                Text="正在查询云端数据..." />
                        </StackPanel>
                        <!--  云端查询中  -->
                        <StackPanel
                            Margin="0,16,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding CloudCheckingVisibility}">
                            <ProgressBar
                                Width="18"
                                Height="18"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                IsIndeterminate="True"
                                Style="{StaticResource MaterialDesignCircularProgressBar}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Opacity="0.6"
                                Text="正在查询云端数据..." />
                        </StackPanel>
                        <!--  云端查询结果：状态文字  -->
                        <TextBlock
                            Margin="0,16,0,0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{Binding CloudResultColor}"
                            Text="{Binding CloudResultText}"
                            TextWrapping="Wrap"
                            Visibility="{Binding CloudResultVisibility}" />
                        <!--  云端记录详情（有数据时才显示）  -->
                        <Border
                            Margin="0,8,0,0"
                            Padding="10"
                            Background="#E8F5E9"
                            CornerRadius="6"
                            Visibility="{Binding CloudRecordVisibility}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,2,8,2"
                                    FontSize="12"
                                    Foreground="#555555"
                                    Text="设备ID：" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,2"
                                    FontSize="12"
                                    Foreground="#212121"
                                    Text="{Binding CloudRecordDeviceId}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,2,8,2"
                                    FontSize="12"
                                    Foreground="#555555"
                                    Text="更新时间：" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,2"
                                    FontSize="12"
                                    Foreground="#212121"
                                    Text="{Binding CloudRecordUpdatedAt}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,2,8,2"
                                    FontSize="12"
                                    Foreground="#555555"
                                    Text="数据链接：" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,2"
                                    FontSize="12"
                                    Foreground="#1976D2"
                                    Text="{Binding CloudRecordContentUrl}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </md:Card>
            </Grid>

            <StackPanel
                Grid.Row="2"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="220"
                    Height="46"
                    md:ButtonAssist.CornerRadius="23"
                    Command="{Binding ConfirmCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    ToolTip="验证通过后点击进入测试">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon
                            Width="22"
                            Height="22"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="CheckCircleOutline" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="确认并进入测试" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </md:DialogHost>
</UserControl>