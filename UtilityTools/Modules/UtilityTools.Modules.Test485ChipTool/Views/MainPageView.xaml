<UserControl x:Class="UtilityTools.Modules.Test485ChipTool.Views.MainPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UtilityTools.Modules.Test485ChipTool.Views"
             xmlns:localCv ="clr-namespace:UtilityTools.Modules.Test485ChipTool.Converter"             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <localCv:ColorConverter  x:Key="ColorConverter"/>
    </UserControl.Resources>

    <ScrollViewer>
    <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="650"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

        <Border Grid.Row="0"
        Grid.Column="0"
        Grid.RowSpan="2"
        CornerRadius="10"
        BorderThickness="2"
        BorderBrush="AntiqueWhite"
        Margin="10,10,10,10" Grid.ColumnSpan="2" />

        <Border Grid.Row="0"
        Grid.Column="1"
        Grid.RowSpan="2"
        CornerRadius="10"
        BorderThickness="2"
        BorderBrush="AntiqueWhite"
        Margin="10,10,10,10" >
            <TextBlock TextWrapping="Wrap" Text="{Binding Log}"/>
        </Border>

        <Label Content="测试参数"
       Grid.Row="0"
       FontSize="30"
       Grid.Column="0"
       HorizontalContentAlignment="Center" 
       VerticalContentAlignment="Center" />

        <Label Content="测试结果"
       Grid.Row="0"
       FontSize="30"
       Grid.Column="2"
       HorizontalContentAlignment="Center" 
       VerticalContentAlignment="Center"/>

        <DockPanel Grid.Row="1"
            LastChildFill="False"
            VerticalAlignment="Center">

            <DockPanel DockPanel.Dock="Top"
                        Margin="20, 10">
                <TextBlock Text="通讯协议"
                    Margin="0, 0, 10, 0"
                    DockPanel.Dock="Left"
                    FontSize="16" Width="112" />
                <ComboBox ItemsSource="{Binding ConnectionTypes}"
                      SelectedItem="{Binding SelectedConnectionType, Mode=TwoWay}"
                      DisplayMemberPath="Description"
                      SelectedValuePath="Value"/>
            </DockPanel>

            <DockPanel DockPanel.Dock="Top"
                Margin="20, 10">
                <TextBlock Text="目标主机IP地址"
                    Margin="0, 0, 10, 0"
                    DockPanel.Dock="Left"
                    FontSize="16" />
                <TextBox Text="{Binding RemoteIp}" />
            </DockPanel>
                <!--
            <DockPanel DockPanel.Dock="Top"
                Margin="20, 10">
                <TextBlock Text="目标主机端口号"
                    DockPanel.Dock="Left"
                    FontSize="16" />

                    <UniformGrid DockPanel.Dock="Top" Rows="1">
                        <TextBox Text="{Binding RemotePort_Start}"/>
                        <TextBlock Text="—" TextAlignment="Center"/>
                        <TextBox Text="{Binding RemotePort_End}"/>
                    </UniformGrid>
                </DockPanel>
                
                <DockPanel DockPanel.Dock="Top"
                Margin="20, 10">
                <TextBlock Text="本地主机IP地址"
                    DockPanel.Dock="Left"
                    FontSize="16"
                    Margin="0, 0, 10, 0" />
                <TextBox Text="{Binding HostIP}" />
            </DockPanel>
            <DockPanel DockPanel.Dock="Top"
                Margin="20, 10">
                <TextBlock Text="本地主机端口号"
                    DockPanel.Dock="Left"
                    FontSize="16"
                    Margin="0, 0, 10, 0" />
                <TextBox Text="{Binding HostPort}"
                  TextAlignment="Center" />
            </DockPanel>
            -->
            <DockPanel DockPanel.Dock="Top"
                 Margin="20, 10">
                <TextBlock Text="指令码"
                    DockPanel.Dock="Left"
                    FontSize="16"
                    Margin="0, 0, 10, 0" Width="112" />
                <ComboBox ItemsSource="{Binding CommandNames}"
                    SelectedItem="{Binding SelectedCommandName, Mode=TwoWay}"
                    DisplayMemberPath="Description"
                    SelectedValuePath="Value"/>
            </DockPanel>
            <DockPanel DockPanel.Dock="Top"
                Margin="20, 10">
                <TextBlock Text="地址码"
                    DockPanel.Dock="Left"
                    FontSize="16"
                    Margin="0, 0, 10, 0" Width="112" />
                <ComboBox ItemsSource="{Binding AddressCodes}"
                    SelectedItem="{Binding SelectedAddressCode, Mode=TwoWay}"
                    DisplayMemberPath="Description"
                    SelectedValuePath="Value"/>
            </DockPanel>
            <DockPanel DockPanel.Dock="Top"
                Margin="20, 10">
                <TextBlock Text="设备码"
                    DockPanel.Dock="Left"
                    FontSize="16"
                    Margin="0, 0, 10, 0" Width="112" />
                <ComboBox ItemsSource="{Binding DeviceIDs }"
                    SelectedItem="{Binding SelectedDeviceID, Mode=TwoWay}"
                    DisplayMemberPath="Description"
                    SelectedValuePath="Value"/>
            </DockPanel>
        </DockPanel>

        <Button Grid.Row="1"
         Content="开始测试"
         Margin="0,500,200,0"
         HorizontalContentAlignment="Center"
         Command="{Binding ClickTest}"
         CommandParameter="ConnectOrNot" Height="24" VerticalAlignment="Top" HorizontalAlignment="Right" Width="154" Grid.Column="1" Grid.ColumnSpan="2" />
    </Grid>
    </ScrollViewer>
</UserControl>
