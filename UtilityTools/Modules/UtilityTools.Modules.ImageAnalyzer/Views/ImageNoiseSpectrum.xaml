<UserControl x:Class="UtilityTools.Modules.ImageAnalyzer.Views.ImageNoiseSpectrum"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:local="clr-namespace:UtilityTools.Modules.ImageAnalyzer.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="dgCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>
        
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <oxy:PlotView Grid.Row="0" Grid.Column="0" Model="{Binding RowSpectrumMeanOxyModel}">
                <oxy:PlotView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding SpectrumAxisType}" Command="{Binding ChangeSpectrumAxisTypeCommand}" />
                    </ContextMenu>
                </oxy:PlotView.ContextMenu>
            </oxy:PlotView>
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <oxy:PlotView  Grid.Column="0" Model="{Binding RowSpectrumOxyModel}" Margin="5"/>
                <DataGrid Grid.Column="1" AutoGenerateColumns="False" ItemsSource="{Binding RowSpectrumPeakList}" Width="auto" Margin="5" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding ID}" ClipboardContentBinding="{x:Null}" Header="序号" ElementStyle="{StaticResource dgCell}" />
                        <DataGridTextColumn Binding="{Binding Freq, StringFormat={}{0:N2}}" ClipboardContentBinding="{x:Null}" Header="频率" ElementStyle="{StaticResource dgCell}" />
                        <DataGridTextColumn Binding="{Binding Magnitude, StringFormat={}{0:N2}}" ClipboardContentBinding="{x:Null}" Header="幅值" ElementStyle="{StaticResource dgCell}"/>
                        <DataGridTemplateColumn>
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="操作"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{md:PackIcon Kind=TrashCanOutline}" 
                                            Command="{Binding DataContext.DelRowPeakCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" 
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignToolButton}" Padding="0" Margin="0" Height="20"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <oxy:PlotView Grid.Row="0" Grid.Column="0" Model="{Binding ColumnSpectrumMeanOxyModel}">
                <oxy:PlotView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding SpectrumAxisType}" Command="{Binding ChangeSpectrumAxisTypeCommand}" />
                    </ContextMenu>
                </oxy:PlotView.ContextMenu>
            </oxy:PlotView>
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <oxy:PlotView Grid.Column="0" Model="{Binding ColumnSpectrumOxyModel}" Margin="5"/>

                <DataGrid Grid.Column="1" AutoGenerateColumns="False" ItemsSource="{Binding ColumnSpectrumPeakList}" Width="auto" Margin="5" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding ID}" ClipboardContentBinding="{x:Null}" Header="序号" ElementStyle="{StaticResource dgCell}" />
                        <DataGridTextColumn Binding="{Binding Freq, StringFormat={}{0:N2}}" ClipboardContentBinding="{x:Null}" Header="频率" ElementStyle="{StaticResource dgCell}"/>
                        <DataGridTextColumn Binding="{Binding Magnitude, StringFormat={}{0:N2}}" ClipboardContentBinding="{x:Null}" Header="幅值" ElementStyle="{StaticResource dgCell}"/>
                        <DataGridTemplateColumn>
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="操作"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{md:PackIcon Kind=TrashCanOutline}" 
                                            Command="{Binding DataContext.DelColumnPeakCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" 
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignToolButton}" Padding="0" Margin="0" Height="20"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
