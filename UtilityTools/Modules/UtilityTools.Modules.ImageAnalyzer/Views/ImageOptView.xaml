<UserControl x:Class="UtilityTools.Modules.ImageAnalyzer.Views.ImageOptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:model="clr-namespace:UtilityTools.Core.Model;assembly=UtilityTools.Core"
             xmlns:views="clr-namespace:UtilityTools.UserControls.Views;assembly=UtilityTools.UserControls"
             xmlns:local="clr-namespace:UtilityTools.Modules.ImageAnalyzer.Views"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <!--显示元数据属性模板-->
        <DataTemplate x:Key="MetadataItemDataTemplate"
                      DataType="{x:Type model:PropertyInfoModel}">
            <DockPanel LastChildFill="True"
                       VerticalAlignment="Center">
                <Label Content="{Binding Description}"
                       DockPanel.Dock="Left"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center" />
                <Label Content="{Binding Value}"
                       DockPanel.Dock="Right"
                       HorizontalContentAlignment="Left"
                       VerticalContentAlignment="Center" />
            </DockPanel>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <DockPanel LastChildFill="False"
                   Margin="5"
                   Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="5">
            <Button Content="保存结果"
                    Margin="3"
                    DockPanel.Dock="Right"
                    Command="{Binding ExecuteCommand}"
                    CommandParameter="Save" />
            <Button Content="清除变更"
                    Margin="3"
                    DockPanel.Dock="Right"
                    Command="{Binding ExecuteCommand}"
                    CommandParameter="Clear" />
            <Button Content="添加丝印"
                    Margin="3"
                    DockPanel.Dock="Right"
                    Command="{Binding ExecuteCommand}"
                    CommandParameter="Silk" />
            <Button Content="图像拉伸"
                    Margin="3"
                    DockPanel.Dock="Right"
                    Command="{Binding ExecuteCommand}"
                    CommandParameter="Reset" />
        </DockPanel>

        <views:ImageViewer ImageSource="{Binding SrcBitmap}"
                           Grid.Column="0"
                           Grid.Row="1" />

        <GridSplitter Grid.Row="1"
                      Grid.Column="1"
                      VerticalAlignment="Stretch"/>

        <views:ImageViewer ImageSource="{Binding FilterBitmap}"
                           Grid.Column="2"
                           Grid.Row="1" />

        <GridSplitter Grid.Row="1"
                      Grid.Column="3"
                      VerticalAlignment="Stretch" />

        <DockPanel Grid.Column="4"
                    Grid.Row="1">
            <!--<ItemsControl DockPanel.Dock="Top"
                          ItemsSource="{Binding Items}"
                          ItemTemplate="{StaticResource MetadataItemDataTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>-->
            <DataGrid Grid.Column="0"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      ItemsSource="{Binding Items}"
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="属性名称"
                                        Width="1*"
                                        IsReadOnly="True"
                                        Binding="{Binding Description}" />
                    <DataGridTextColumn Header="属性值"
                                        Width="2*"
                                        Binding="{Binding Value}" />
                </DataGrid.Columns>
            </DataGrid>
            
        </DockPanel>

    </Grid>
</UserControl>
