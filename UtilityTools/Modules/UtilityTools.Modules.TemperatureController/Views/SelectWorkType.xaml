<UserControl x:Class="UtilityTools.Modules.TemperatureController.Views.SelectWorkType"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UtilityTools.Modules.TemperatureController.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"> 
    <Grid>
        <Border CornerRadius="10" 
             VerticalAlignment="Center" HorizontalAlignment="Center"
             Width="400" Height="300">
            <StackPanel Margin="20" VerticalAlignment="Center">
                <TextBlock Text="请选择工作类型" FontSize="20" FontWeight="Bold" 
                        HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <RadioButton x:Name="ColdTableRadio" GroupName="WorkType"
                          IsChecked="{Binding IsColdModeSelected}" Content="冷台模式" Margin="10" FontSize="16"/>
                <RadioButton x:Name="HotTableRadio" GroupName="WorkType"
                          IsChecked="{Binding IsHotModeSelected}" Content="热台模式" Margin="10" FontSize="16"/>

                <Button Content="确认选择" Click="ConfirmButton_Click"
                     Margin="0,30,0,0" Height="40" FontSize="16"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
