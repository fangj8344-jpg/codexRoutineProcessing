<UserControl x:Class="UtilityTools.Modules.IonPump.Views.GammaIonPump"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cv="clr-namespace:UtilityTools.Core.Converter;assembly=UtilityTools.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ex="clr-namespace:UtilityTools.Core.Extension;assembly=UtilityTools.Core"
             xmlns:local="clr-namespace:UtilityTools.Modules.IonPump.Views"
             xmlns:model="clr-namespace:UtilityTools.Modules.IonPump.Protocol"
             mc:Ignorable="d" 
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>

        <cv:BoolToColorConverter x:Key="BoolToColorConverter" />

    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock Text="串口设置" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Left" Command="{Binding ShowDeviceCommand}" Content="{md:PackIcon Kind=UsbPort, Size=24}" Style="{StaticResource MaterialDesignToolButton}"
                    Foreground="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False">
                    <ComboBox DockPanel.Dock="Left" Margin="3" ItemsSource="{Binding Source={ex:Enum {x:Type model:EnumCommand}}}" DisplayMemberPath="Description" SelectedValuePath="Value" SelectedValue="{Binding SelectedCmd}"/>
                    <TextBox DockPanel.Dock="Left" Width="150" Margin="3"/>
                    <Button DockPanel.Dock="Left" Content="发送" Margin="3" Command="{Binding SendCmdCommand}"/>
                    <TextBox Text="{Binding RespPacketDataStr}" DockPanel.Dock="Left" Width="150" Margin="3" IsReadOnly="True"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
