<UserControl x:Class="UtilityTools.Modules.IonPump.Views.AgilentIonPump"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cv="clr-namespace:UtilityTools.Core.Converter;assembly=UtilityTools.Core"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UtilityTools.Modules.IonPump.Views"
             xmlns:attach="clr-namespace:UtilityTools.Core.Attach;assembly=UtilityTools.Core"
             xmlns:oxy="http://oxyplot.org/wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>

        <cv:BoolToColorConverter x:Key="BoolToColorConverter" />

    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="False"> 
            <TextBlock Text="串口设置" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Left" Command="{Binding ShowDeviceCommand}" Content="{md:PackIcon Kind=UsbPort, Size=24}" Style="{StaticResource MaterialDesignToolButton}"
                    Foreground="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button DockPanel.Dock="Left"
                    Command="{Binding ShowNetDeviceCommand}"
                    Style="{StaticResource MaterialDesignToolButton}"
                    Content="{md:PackIcon Kind=EthernetCable, Size=24}"
                    Foreground="{Binding NetIsConnected, Converter={StaticResource BoolToColorConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Grid.RowSpan="2" Margin="10,10,10,39" >
                <DockPanel DockPanel.Dock="Left" Width="400" Margin="0, 0, 10, 0">
                    <ListView ItemsSource="{Binding Logs}" DockPanel.Dock="Bottom" Height="300">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="通讯日志" Width="380" DisplayMemberBinding="{Binding }" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding CustomCmds}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="自动发送" Binding="{Binding IsAutoSend}" />
                            <DataGridTextColumn Header="消息报文" Binding="{Binding CmdString}" IsReadOnly="False" />
                            <DataGridTemplateColumn Header="操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="发送" Command="{Binding SendCmdStringCommand}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                
                <Grid DockPanel.Dock="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <!--<Label Content="设备状态" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />-->
                    <Button Content="设备状态" Grid.Row="0" Grid.Column="0" Command="{Binding QueryStatusCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="5, 0, 5, 0" />
                    <Button Content="错误码" Grid.Row="0" Grid.Column="1" Command="{Binding QueryErrorCodeCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="5, 0, 5, 0" />
                    <Button Content="压强单位" Grid.Row="0" Grid.Column="2" Command="{Binding QueryPressureUnitCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="5, 0, 5, 0" />
                    <Button Content="最大功率" Grid.Row="0" Grid.Column="3" Command="{Binding QueryMaxPowerCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="5, 0, 5, 0" />

                    <Label Content="{Binding IonPumpVo.Status}" Foreground="LightBlue" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <Label Content="{Binding IonPumpVo.ErrorCode}" Foreground="LightBlue" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <Label Content="{Binding IonPumpVo.PressureUnit}" Foreground="LightBlue" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <Label Content="{Binding IonPumpVo.MaxPower}" Foreground="LightBlue" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

                    <Button Content="温度" Grid.Row="2" Grid.Column="0" Command="{Binding QueryTempCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="5, 0, 5, 0" />
                    <Button Content="电压" Grid.Row="2" Grid.Column="1" Command="{Binding QueryVoltageCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="5, 0, 5, 0" />
                    <Button Content="压强" Grid.Row="2" Grid.Column="2" Command="{Binding QueryPressureCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="5, 0, 5, 0" />
                    <Button Content="电流" Grid.Row="2" Grid.Column="3" Command="{Binding QueryCurrentCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="5, 0, 5, 0" />

                    <Label Content="{Binding IonPumpVo.Temp}" Foreground="LightBlue" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <Label Content="{Binding IonPumpVo.Voltage}" Foreground="LightBlue" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <Label Content="{Binding IonPumpVo.Pressure}" Foreground="LightBlue" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <Label Content="{Binding IonPumpVo.Current}" Foreground="LightBlue" Grid.Row="3" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />


                    <oxy:PlotView Model="{Binding IronPumpPlotModel}" Grid.Row="4" Grid.ColumnSpan="4">
                        <oxy:PlotView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="加载" Command="{Binding LoadMonitorInfoCommand}" />
                                <MenuItem Header="另存为" Command="{Binding SaveMonitorInfoCommand}" />
                                <MenuItem Header="清除" Command="{Binding ClearMonitorCommand}" />
                            </ContextMenu>
                        </oxy:PlotView.ContextMenu>
                    </oxy:PlotView>
                    
                </Grid>
                
            </DockPanel>

            <DockPanel Grid.Row="1"  Grid.ColumnSpan="2" Margin="3" LastChildFill="False">
                <Button Content="设置目标电压(V):" Command="{Binding SetTargetVolCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="5, 0, 5, 0" />
                <TextBox Text="{Binding TargetVoltage}" VerticalAlignment="Center" Padding="10, 0, 12, 0" attach:TextBoxAttached.IsEnterEndEdit="True" attach:TextBoxAttached.IsOnlyNumbers="True" attach:TextBoxAttached.IsSupportWheel="True" DockPanel.Dock="Left" Margin="5, 0, 5, 0" />
                <Button Content="开启高压" Command="{Binding SetHvOnCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="5, 0, 5, 0" />
                <Button Content="关闭高压" Command="{Binding SetHvOffCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="5, 0, 5, 0" />
            </DockPanel>

            <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="3" LastChildFill="False" >
                <Label Content="采样间隔(ms):" HorizontalAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="5, 0, 5, 0" />
                <TextBox Text="{Binding MonitorInterval}" VerticalAlignment="Center" Padding="10, 0, 12, 0" attach:TextBoxAttached.IsEnterEndEdit="True" attach:TextBoxAttached.IsOnlyNumbers="True" attach:TextBoxAttached.IsSupportWheel="True" DockPanel.Dock="Left" Margin="5, 0, 5, 0" />
                <Button DockPanel.Dock="Left" Command="{Binding ChangeMonitorStateCommand}" Content="{Binding MonitorState}" Margin="5, 0, 5, 0" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
