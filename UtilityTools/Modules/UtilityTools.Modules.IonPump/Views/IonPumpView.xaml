<UserControl x:Class="UtilityTools.Modules.IonPump.Views.IonPumpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UtilityTools.Modules.IonPump.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cv="clr-namespace:UtilityTools.Core.Converter;assembly=UtilityTools.Core"
             xmlns:model="clr-namespace:UtilityTools.Modules.IonPump.Model"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True" >
    <UserControl.Resources>
        <cv:BoolToColorConverter x:Key="BoolToColorConverter" />
    </UserControl.Resources>
    <md:DialogHost Identifier="{x:Static model:CommonModel.IonPumpRegionName}" DialogTheme="Inherit">
        <TabControl>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="{md:PackIcon Kind=Pump}" VerticalAlignment="Stretch"/>
                        <TextBlock Text="安捷伦离子泵" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:AgilentIonPump DataContext="{Binding AgilentIonPumpVM}"/>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="{md:PackIcon Kind=Waveform}" VerticalAlignment="Stretch"/>
                        <TextBlock Text="爱德华离子泵" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:GammaIonPump/>
            </TabItem>
        </TabControl>
    </md:DialogHost>
</UserControl>
