<UserControl x:Class="UtilityTools.Modules.CmdTestTool.Views.CmdTestToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cv="clr-namespace:UtilityTools.Core.Converter;assembly=UtilityTools.Core"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:model="clr-namespace:UtilityTools.Modules.CmdTestTool.Model"
             xmlns:local="clr-namespace:UtilityTools.Modules.CmdTestTool.Views"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <cv:BoolToColorConverter x:Key="BoolToColorConverter" />

        <DataTemplate x:Key="CmdModelTemplate"
                      DataType="{x:Type model:CmdModel}">
            <DockPanel LastChildFill="True"
                       Margin="10"
                       VerticalAlignment="Center">
                <Button Content="发送"
                        DockPanel.Dock="Right"
                        Command="{Binding SendCommand}" />
                <TextBox Text="{Binding CmdType}"
                         Width="60"
                         ToolTip="设备ID"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center" />
                <TextBox Text="{Binding CmdData}"
                         ToolTip="指令数据段"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <md:DialogHost Identifier="{x:Static model:CommonModel.CmdTestToolRegionName}"
                   DialogTheme="Inherit">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0"
                       Margin="10"
                       LastChildFill="False">
                <TextBlock Text="网络通讯控制板"
                           FontSize="20"
                           FontWeight="Bold"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding ShowDeviceCommand}"
                        Content="{md:PackIcon Kind=EthernetCable, Size=24}"
                        Style="{StaticResource MaterialDesignToolButton}"
                        Foreground="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding CmdModelList}"
                          ItemTemplate="{StaticResource CmdModelTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <ListView ItemsSource="{Binding Logs}"
                      Grid.Row="2">
                <ListView.View>
                    <GridView>
                        <GridViewColumn  Header="报文信息" />
                    </GridView>
                </ListView.View>
            </ListView>
            
            <DockPanel Grid.Row="3">
                <Button Content="清除日志" DockPanel.Dock="Right" Command="{Binding ClearLogCommand}"/>
            </DockPanel>
        </Grid>
    </md:DialogHost>
</UserControl>
