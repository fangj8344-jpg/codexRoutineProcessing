<UserControl x:Class="UtilityTools.Modules.ImageComparator.Views.ImageComparatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Select Image 1" Command="{Binding SelectImage1Command}" Margin="0,0,10,0"/>
            <Button Content="Select Image 2" Command="{Binding SelectImage2Command}" Margin="0,0,10,0"/>
            <Button Content="Compare Images" Command="{Binding CompareImagesCommand}" IsEnabled="{Binding CanCompare}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,5,0">
                <Image Source="{Binding Image1}" Stretch="Uniform"/>
            </Border>

            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="5,0">
                <Image Source="{Binding Image2}" Stretch="Uniform"/>
            </Border>

            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Margin="5,0,0,0">
                <Image Source="{Binding ResultImage}" Stretch="Uniform"/>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Margin="0,0,0,5"/>
            <TextBlock>
                <Run Text="Offset X: "/>
                <Run Text="{Binding OffsetX}"/>
                <Run Text=" pixels"/>
            </TextBlock>
            <TextBlock>
                <Run Text="Offset Y: "/>
                <Run Text="{Binding OffsetY}"/>
                <Run Text=" pixels"/>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl> 