<UserControl x:Class="UtilityTools.Modules.CCSTool.Views.CCSToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UtilityTools.Modules.CCSTool.Views"
             xmlns:cv="clr-namespace:UtilityTools.Core.Converter;assembly=UtilityTools.Core"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:model="clr-namespace:UtilityTools.Modules.CCSTool.Model"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <cv:BoolToColorConverter x:Key="boolToColorConverter" />
    </UserControl.Resources>

    <md:DialogHost Identifier="{x:Static model:CommonModel.CCSToolRegionName}"
                   DialogTheme="Inherit">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0"
                       Margin="10"
                       LastChildFill="False">
                <TextBlock Text="CCS控制工具"
                           FontSize="20"
                           FontWeight="Bold"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding ShowDeviceCommand}"
                        Content="{md:PackIcon Kind=UsbPort, Size=24}"
                        Style="{StaticResource MaterialDesignToolButton}"
                        Foreground="{Binding IsConnected, Converter={StaticResource boolToColorConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <UniformGrid Grid.Row="1" Columns="2">
                <local:ControlItemView DataContext="{Binding ModelA}" Margin="10"/>
                <local:ControlItemView DataContext="{Binding ModelB}" Margin="10"/>
            </UniformGrid>
        </Grid>
    </md:DialogHost>
</UserControl>
