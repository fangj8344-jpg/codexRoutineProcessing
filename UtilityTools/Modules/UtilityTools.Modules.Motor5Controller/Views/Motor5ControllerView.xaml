<UserControl x:Class="UtilityTools.Modules.Motor5Controller.Views.Motor5ControllerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:cv="clr-namespace:UtilityTools.Core.Converter;assembly=UtilityTools.Core"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:model="clr-namespace:UtilityTools.Modules.Motor5Controller.Model"
             xmlns:local="clr-namespace:UtilityTools.Modules.Motor5Controller.Views"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:bh="clr-namespace:UtilityTools.Core.Behavior;assembly=UtilityTools.Core"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <cv:BoolToColorConverter x:Key="BoolToColorConverter" />
        <cv:BoolToVisibilityConverter x:Key="boolToVisibilityConverter" />
    </UserControl.Resources>

    <md:DialogHost Identifier="{x:Static model:CommonModel.Motor5ControllerRegionName}"
                   DialogTheme="Inherit">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0"
                       Margin="10"
                       LastChildFill="False">
                <TextBlock Text="五轴电机控制"
                           FontSize="20"
                           FontWeight="Bold"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding ShowDeviceCommand}"
                        CommandParameter="ShowNetConf"
                        Content="{md:PackIcon Kind=UsbPort, Size=24}"
                        Style="{StaticResource MaterialDesignToolButton}"
                        Foreground="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TabControl Grid.Column="0"
                            ItemsSource="{Binding MotorList}">
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                <local:MotorView />
                            </ScrollViewer>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Header"
                                    Value="{Binding MotorId}" />
                        </Style>
                    </TabControl.ItemContainerStyle>
                </TabControl>

                <GridSplitter Grid.Column="1"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Background="Black"
                              ShowsPreview="True"
                              Width="5" />
                
                <TabControl Grid.Column="2">
                    <TabItem Header="监控数据">
                        <oxy:PlotView Model="{Binding MonitorPlotModel}"
                                      Foreground="Black">
                            <oxy:PlotView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="清除"
                                              Command="{Binding ClearMonitorCommand}"
                                              CommandParameter="ImageParam" />
                                    <MenuItem Header="自适应"
                                              Command="{Binding AutoAdjustComamnd}"
                                              CommandParameter="ImageParam" />
                                    <MenuItem Header="保存到文件"
                                              Command="{Binding SaveToFileCommand}"
                                              CommandParameter="ImageParam" />
                                </ContextMenu>
                            </oxy:PlotView.ContextMenu>
                        </oxy:PlotView>
                    </TabItem>
                    <TabItem Header="日志数据">
                        <DockPanel LastChildFill="True">
                            <ListView ItemsSource="{Binding Logs}"
                                      SelectedIndex="{Binding SelectedIndex}"
                                      VerticalAlignment="Top">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn  Header="报文信息" />
                                    </GridView>
                                </ListView.View>
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="清除" Command="{Binding CleanLogCommand}"/>
                                        <MenuItem Header="复制" Command="{Binding CopyLogCommand}"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <i:Interaction.Behaviors>
                                    <bh:AutoScrollBehavior/>
                                </i:Interaction.Behaviors>
                            </ListView>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>

        </Grid>
    </md:DialogHost>

</UserControl>


	

