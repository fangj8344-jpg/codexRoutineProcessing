<UserControl x:Class="UtilityTools.Modules.Motor5Controller.Views.MotorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UtilityTools.Modules.Motor5Controller.Views"
             xmlns:cv="clr-namespace:UtilityTools.Core.Converter;assembly=UtilityTools.Core"
             mc:Ignorable="d"
             FontSize="12"
             d:DesignHeight="900"
             d:DesignWidth="300">
    <UserControl.Resources>
        <cv:EnumDescriptionConverter x:Key="enumDescriptionConverter" />
    </UserControl.Resources>

    <Border BorderBrush="Black"
            BorderThickness="2">
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label Content="{Binding MotorId, Converter={StaticResource enumDescriptionConverter}}"
                   Margin="2"
                   Grid.Row="0" />

            <DockPanel Grid.Row="1">
                <Label Content="电机设置方法" />
                <Rectangle Fill="White"
                           Height="2" />
            </DockPanel>

            <local:MotorSetParamsView Margin="5"
                                      DataContext="{Binding SetParams}"
                                      Grid.Row="2" />

            <DockPanel Grid.Row="3">
                <Label Content="电机获取方法" />
                <CheckBox DockPanel.Dock="Right"
                          Content="是否自动读取"
                          IsChecked="{Binding IsAutoRead}" />
                <Rectangle Fill="White"
                           Height="2" />
            </DockPanel>

            <local:MotorReadParamsView Margin="5"
                                       DataContext="{Binding ReadParams}"
                                       Grid.Row="4" />

        </Grid>
    </Border>

</UserControl>
