<Window x:Class="UtilityTools.Modules.MotorTest.Views.ThreeAxisTestModelWindowsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cv="clr-namespace:UtilityTools.Core.Converter;assembly=UtilityTools.Core"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:UtilityTools.Modules.MotorTest.ViewModels"
        xmlns:model="clr-namespace:UtilityTools.Modules.MotorTest.Model"
        xmlns:local="clr-namespace:UtilityTools.Modules.MotorTest.Views"
        xmlns:prism ="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Title="ThreeAzisTestModelWindowsView" Height="900" Width="1600">
    <Window.Resources>
        <cv:BoolToColorConverter x:Key="BoolToColorConverter" />
    </Window.Resources>

    <md:DialogHost Identifier="{x:Static model:CommonModel.ThreeAxisTestModelWindowsViewModelRegionName}"
            DialogTheme="Inherit">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0"
                       Margin="10"
                       LastChildFill="False">
                <TextBlock Text="电机测试"
                           FontSize="20"
                           FontWeight="Bold"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding ShowNetDeviceCommand}"
                        Content="{md:PackIcon Kind=EthernetCable, Size=24}"
                        Style="{StaticResource MaterialDesignToolButton}"
                        Foreground="{Binding NetIsConnected, Converter={StaticResource BoolToColorConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding ShowDeviceCommand}"
                        Content="{md:PackIcon Kind=UsbPort, Size=24}"
                        Style="{StaticResource MaterialDesignToolButton}"
                        Foreground="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <local:ThreeAzisTestControl Grid.Row="1" DataContext="{Binding Model}" />
        </Grid>
    </md:DialogHost>
</Window>
