                                <Label Content="位置（脉冲）"/>
                                <Label Content="{Binding ZAxis.MotorModel.MotorParams.Pos}" />
                                <Label Content="速度（脉冲/s）"/>
                                <Label Content="{Binding ZAxis.MotorModel.MotorParams.Speed}" />
