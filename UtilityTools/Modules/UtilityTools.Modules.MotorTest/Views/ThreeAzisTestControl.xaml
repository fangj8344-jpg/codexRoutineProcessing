                                <Label Content="限位状态"/>
                                <Label Content="{Binding ZAxis.MotorModel.MotorParams.LimitedState}"/>
                                <Label Content="软正限位状态"/>
                                <Label Content="{Binding ZAxis.MotorModel.MotorParams.SPLimted}"/>
                                <Label Content="软负限位状态"/>
                                <Label Content="{Binding ZAxis.MotorModel.MotorParams.SNLimted}"/>
                                <Label Content="轴类型"/>
                                <Label Content="{Binding ZAxis.MotorModel.MotorParams.MoveType}"/>
                                <Label Content="转换系数"/>
                                <Label Content="{Binding ZAxis.MotorModel.MotorParams.SubRatio}"/>
                            </UniformGrid>
                        </TabItem>
                        <TabItem Header="t轴">
                            <UniformGrid Columns="4">
                                <Label Content="位置（脉冲）"/>
