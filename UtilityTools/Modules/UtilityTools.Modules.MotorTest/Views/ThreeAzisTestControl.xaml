                                <Label Content="{Binding TAxis.MotorModel.MotorParams.MoveType}"/>
                                <Label Content="转换系数"/>
                                <Label Content="{Binding TAxis.MotorModel.MotorParams.SubRatio}"/>
                            </UniformGrid>
                        </TabItem>
                        <TabItem Header="r轴">
                            <UniformGrid Columns="4">
                                <Label Content="位置（脉冲）"/>
                                <Label Content="{Binding RAxis.MotorModel.MotorParams.Pos}" />
