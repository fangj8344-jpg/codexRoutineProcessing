                            </UniformGrid>
                        </TabItem>
                        <TabItem Header="y轴">
                            <UniformGrid Columns="4"  >
                                <Label Content="位置（脉冲）"/>
                                <Label Content="{Binding YAxis.MotorModel.MotorParams.Pos}" />
                                <Label Content="速度（脉冲/s）"/>
                                <Label Content="{Binding YAxis.MotorModel.MotorParams.Speed}" />
                                <Label Content="控制模式"/>
