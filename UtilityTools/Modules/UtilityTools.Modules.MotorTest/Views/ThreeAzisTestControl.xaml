<UserControl x:Class="UtilityTools.Modules.MotorTest.Views.ThreeAzisTestControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:oxy="http://oxyplot.org/wpf" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:bh="clr-namespace:UtilityTools.Core.Behavior;assembly=UtilityTools.Core"
             xmlns:local="clr-namespace:UtilityTools.Modules.MotorTest.Views"
             xmlns:mm="clr-namespace:UtilityTools.Modules.MotorTest.Model"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="Transparent" Foreground="{DynamicResource MaterialDesignBody}" FontSize="15" Margin="5,0,0,5" VerticalAlignment="Center">
            <MenuItem Header="文件" Padding="10,5">
                <MenuItem Header="加载设置">
                    <DockPanel LastChildFill="False" Margin="5">
                        <Label Content="起始点" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding HeadIndex}" MinWidth="40" Margin="5,0,15,0" Style="{StaticResource MaterialDesignTextBox}"/>
                        <Label Content="加载点数" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding LoadSize}" MinWidth="40" Margin="5,0,0,0" Style="{StaticResource MaterialDesignTextBox}"/>
                    </DockPanel>
                </MenuItem>
                <MenuItem Header="最大显示点数">
                    <TextBox Text="{Binding MaxCount}" MinWidth="60" Margin="10,2" Style="{StaticResource MaterialDesignTextBox}"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="55*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="45*"/>
            </Grid.RowDefinitions>

            <md:Card Grid.Row="0" md:ElevationAssist.Elevation="Dp2" UniformCornerRadius="6">
                <TabControl Style="{StaticResource MaterialDesignFilledTabControl}" Margin="0">
                    <TabItem Header="位置曲线图">
                        <oxy:PlotView
                            Model="{Binding MotorplotModel}"
                            Foreground="Black"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True"
                            RenderOptions.EdgeMode="Aliased"
                            RenderOptions.BitmapScalingMode="LowQuality">
                            <oxy:PlotView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="自适应" Command="{Binding AutoAdjustCommand}" CommandParameter="point" />
                                    <MenuItem Header="清除" Command="{Binding ClearMonitorCommand}" CommandParameter="point"/>
                                </ContextMenu>
                            </oxy:PlotView.ContextMenu>
                        </oxy:PlotView>
                    </TabItem>
                    <TabItem Header="速度曲线图">
                        <oxy:PlotView
                            Model="{Binding MotorSpeedplotModel}"
                            Foreground="Black"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True"
                            RenderOptions.EdgeMode="Aliased"
                            RenderOptions.BitmapScalingMode="LowQuality">
                            <oxy:PlotView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="自适应" Command="{Binding AutoAdjustCommand}" CommandParameter="speed"/>
                                    <MenuItem Header="清除" Command="{Binding ClearMonitorCommand}" CommandParameter="speed"/>
                                </ContextMenu>
                            </oxy:PlotView.ContextMenu>
                        </oxy:PlotView>
                    </TabItem>
                </TabControl>
            </md:Card>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>

                <md:Card Grid.Column="0" md:ElevationAssist.Elevation="Dp2" UniformCornerRadius="6" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Center">
                            <RadioButton x:Name="IsSpeedMode" Content="速度模式" IsChecked="{Binding IsSpeedMode}" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="0,0,10,0"/>
                            <RadioButton Content="位置模式" IsChecked="True" Style="{StaticResource MaterialDesignTabRadioButton}"/>
                            <TextBlock Margin="18,0,6,0" VerticalAlignment="Center" Foreground="Gray" Text="速度值(um/s):" />
                            <TextBox
                                Width="90"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding IsChecked, ElementName=IsSpeedMode}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding MagnitudeOfSpeed, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Motors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type mm:FiveAxisModel}">
                                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="5,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="170"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="位置 (μm)" FontSize="10" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding MotorModel.MotorParams.PosUm, StringFormat={}{0:F3}}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="回传速度 (μm/s)" FontSize="10" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding MotorModel.MotorParams.FeedbackSpeedUm, StringFormat={}{0:F3}}" FontWeight="SemiBold"/>
                                                    <TextBlock Margin="0,4,0,0" Text="计算速度 (μm/s)" FontSize="10" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding MotorModel.MotorParams.CalculatedSpeedUm, StringFormat={}{0:F3}}" FontWeight="SemiBold"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Content="←" Command="{Binding ReverseMoveCommand}" CommandParameter="{Binding IsChecked, ElementName=IsSpeedMode}" 
                                                            Style="{StaticResource MaterialDesignRaisedButton}" Background="#555555" Foreground="White" BorderBrush="Transparent" Padding="4" MinWidth="40" Height="32" Margin="0,0,4,0"/>
                                                    <Button Content="→" Command="{Binding ForwardMoveCommand}" CommandParameter="{Binding IsChecked, ElementName=IsSpeedMode}" 
                                                            Style="{StaticResource MaterialDesignRaisedButton}" Background="#555555" Foreground="White" BorderBrush="Transparent" Padding="4" MinWidth="40" Height="32" Margin="0,0,8,0"/>
                                                    <Button Content="停止" Command="{Binding StopMotorCommand}" 
                                                            Style="{StaticResource MaterialDesignRaisedButton}" Background="#ef5350" Foreground="White" BorderBrush="Transparent" Padding="4" MinWidth="45" Height="32"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </md:Card>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

                <md:Card Grid.Column="2" md:ElevationAssist.Elevation="Dp2" UniformCornerRadius="6">
                    <TabControl Style="{StaticResource MaterialDesignFilledTabControl}" Margin="0">
                        <TabItem Header="功能测试面板">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <UniformGrid Columns="3" Margin="10">
                                    <Button Content="基础测试" Command="{Binding TestMotorTogetherCommand}" CommandParameter="BaseTest" Style="{StaticResource MaterialDesignRaisedButton}" Margin="6"/>
                                    <Button Content="并行丝杆测试" Visibility="Collapsed"  Command="{Binding TestMotorTogetherCommand}" CommandParameter="TestSmoothnessDetection" Style="{StaticResource MaterialDesignRaisedButton}" Margin="6"/>
                                    <Button Content="耐久测试" Command="{Binding TestMotorTogetherCommand}" CommandParameter="DurabilityTest" Style="{StaticResource MaterialDesignRaisedButton}" Margin="6"/>
                                    <Button Content="随机坐标重复精度测试" Command="{Binding RandomRepeatabilityTestCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="6"/>

                                    <Button Content="串行基础测试" Visibility="Collapsed" Command="{Binding IndependentMotortestCommand}" CommandParameter="BaseTest" Style="{StaticResource MaterialDesignRaisedButton}" Background="#424242" Foreground="White" BorderBrush="Transparent" Margin="6"/>
                                    <Button Content="串行丝杆测试" Visibility="Collapsed" Command="{Binding IndependentMotortestCommand}" CommandParameter="TestSmoothnessDetection" Style="{StaticResource MaterialDesignRaisedButton}" Background="#424242" Foreground="White" BorderBrush="Transparent" Margin="6"/>
                                    <Button Content="串行耐久测试" Visibility="Collapsed" Command="{Binding IndependentMotorDurabilityTestCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#424242" Foreground="White" BorderBrush="Transparent" Margin="6"/>

                                    <Button Content="开启性能模式" Visibility="Collapsed" Command="{Binding TestPerformanceCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#37474F" Foreground="White" BorderBrush="Transparent" Margin="6"/>
                                    <Button Content="关闭性能模式" Visibility="Collapsed" Command="{Binding CloseTestPerformanceCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#37474F" Foreground="White" BorderBrush="Transparent" Margin="6"/>
                                    <Button Content="数据库加载" Command="{Binding SqliteLoadCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#37474F" Foreground="White" BorderBrush="Transparent" Margin="6"/>

                                    <Button Content="关闭测试" Command="{Binding ShotDownCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#ef5350" Foreground="White" BorderBrush="Transparent" Margin="6"/>
                                </UniformGrid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="随机重复精度">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="220" MinHeight="180"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="200" MinHeight="160"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="200" MinHeight="160"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="220" MinHeight="180"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Padding="10" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Button Content="生成随机重复精度报告"
                                                        Command="{Binding GenerateRandomRepeatabilityReportCommand}"
                                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                                        ToolTip="导出到程序目录「报告\随机重复精度」：Word（摘要+曲线+表格）与同目录 CSV"
                                                        Padding="12,4" Margin="0,0,8,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding RandomRepeatabilitySummary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 目标点 + X/Y 各一份点统计 -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.05*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <DataGrid
                                            Grid.Column="0"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding RandomTargetPoints}"
                                            MinHeight="140"
                                            Style="{StaticResource MaterialDesignDataGrid}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding Index}" Header="序号" Width="56"/>
                                                <DataGridTextColumn Binding="{Binding TargetXUm, StringFormat={}{0:F3}}" Header="目标 X (μm)" MinWidth="100" Width="*"/>
                                                <DataGridTextColumn Binding="{Binding TargetYUm, StringFormat={}{0:F3}}" Header="目标 Y (μm)" MinWidth="100" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <DataGrid
                                            Grid.Column="2"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding RandomPointStatsX}"
                                            MinHeight="140"
                                            Style="{StaticResource MaterialDesignDataGrid}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding PointIndex}" Header="点序号" Width="64"/>
                                                <DataGridTextColumn Binding="{Binding SampleCount}" Header="样本数" Width="72"/>
                                                <DataGridTextColumn Binding="{Binding MeanUm, StringFormat={}{0:F3}}" Header="到位均值 X (μm)" MinWidth="120" Width="*"/>
                                                <DataGridTextColumn Binding="{Binding StdUm, StringFormat={}{0:F3}}" Header="标准差 X (μm)" MinWidth="110" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <DataGrid
                                            Grid.Column="4"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding RandomPointStatsY}"
                                            MinHeight="140"
                                            Style="{StaticResource MaterialDesignDataGrid}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding PointIndex}" Header="点序号" Width="64"/>
                                                <DataGridTextColumn Binding="{Binding SampleCount}" Header="样本数" Width="72"/>
                                                <DataGridTextColumn Binding="{Binding MeanUm, StringFormat={}{0:F3}}" Header="到位均值 Y (μm)" MinWidth="120" Width="*"/>
                                                <DataGridTextColumn Binding="{Binding StdUm, StringFormat={}{0:F3}}" Header="标准差 Y (μm)" MinWidth="110" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>

                                    <TextBlock Grid.Row="2" Margin="0,4,0,0" FontWeight="SemiBold" Opacity="0.95" Text="X 轴行程明细（随机大跨度 MoveState 判停，与短步分段线性测试无关，本表仅 X）"/>

                                    <DataGrid
                                        Grid.Row="3"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding RandomMoveTripsX}"
                                        MinHeight="160"
                                        Style="{StaticResource MaterialDesignDataGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding SeqNo}" Header="序号" Width="56"/>
                                            <DataGridTextColumn Binding="{Binding PointIndex}" Header="点序号" Width="64"/>
                                            <DataGridTextColumn Binding="{Binding PlannedStartUm, StringFormat={}{0:F3}}" Header="计划起点 X (μm)" MinWidth="108" Width="*"/>
                                            <DataGridTextColumn Binding="{Binding ActualStartUm, StringFormat={}{0:F3}}" Header="实际起点 X (μm)" MinWidth="108" Width="*"/>
                                            <DataGridTextColumn Binding="{Binding TargetUm, StringFormat={}{0:F3}}" Header="目标 X (μm)" MinWidth="96" Width="*"/>
                                            <DataGridTextColumn Binding="{Binding ActualTargetUm, StringFormat={}{0:F3}}" Header="实际到位 X (μm)" MinWidth="108" Width="*"/>
                                            <DataGridTextColumn Binding="{Binding MoveTimeMs, StringFormat={}{0:F1}}" Header="移动时间 (ms)" MinWidth="108" Width="*"/>
                                            <DataGridTextColumn Binding="{Binding DistanceUm, StringFormat={}{0:F1}}" Header="计划行程 X (μm)" MinWidth="118" Width="*"/>
                                            <DataGridTextColumn Binding="{Binding AvgSpeedUmPerSec, StringFormat={}{0:F1}}" Header="平均速度 X (μm/s)" MinWidth="130" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Grid.Row="4" Margin="0,8,0,0" FontWeight="SemiBold" Opacity="0.95" Text="Y 轴行程明细（与 X 同次随机判停，本表仅 Y）"/>

                                    <DataGrid
                                        Grid.Row="5"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding RandomMoveTripsY}"
                                        MinHeight="160"
                                        Style="{StaticResource MaterialDesignDataGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding SeqNo}" Header="序号" Width="56"/>
                                            <DataGridTextColumn Binding="{Binding PointIndex}" Header="点序号" Width="64"/>
                                            <DataGridTextColumn Binding="{Binding PlannedStartUm, StringFormat={}{0:F3}}" Header="计划起点 Y (μm)" MinWidth="108" Width="*"/>
                                            <DataGridTextColumn Binding="{Binding ActualStartUm, StringFormat={}{0:F3}}" Header="实际起点 Y (μm)" MinWidth="108" Width="*"/>
                                            <DataGridTextColumn Binding="{Binding TargetUm, StringFormat={}{0:F3}}" Header="目标 Y (μm)" MinWidth="96" Width="*"/>
                                            <DataGridTextColumn Binding="{Binding ActualTargetUm, StringFormat={}{0:F3}}" Header="实际到位 Y (μm)" MinWidth="108" Width="*"/>
                                            <DataGridTextColumn Binding="{Binding MoveTimeMs, StringFormat={}{0:F1}}" Header="移动时间 (ms)" MinWidth="108" Width="*"/>
                                            <DataGridTextColumn Binding="{Binding DistanceUm, StringFormat={}{0:F1}}" Header="计划行程 Y (μm)" MinWidth="118" Width="*"/>
                                            <DataGridTextColumn Binding="{Binding AvgSpeedUmPerSec, StringFormat={}{0:F1}}" Header="平均速度 Y (μm/s)" MinWidth="130" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Grid.Row="6" Margin="0,8,0,4" FontWeight="SemiBold" Opacity="0.95" Text="行程距离 / 速度 分箱（左列为 X，右列为 Y）"/>

                                    <Grid Grid.Row="7">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <DataGrid
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding RandomDistanceHistogramX}"
                                            Style="{StaticResource MaterialDesignDataGrid}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding BinIndex}" Header="X 距离分箱" Width="100"/>
                                                <DataGridTextColumn Binding="{Binding MinValue, StringFormat={}{0:F1}}" Header="下限 (μm)" MinWidth="88" Width="*"/>
                                                <DataGridTextColumn Binding="{Binding MaxValue, StringFormat={}{0:F1}}" Header="上限 (μm)" MinWidth="88" Width="*"/>
                                                <DataGridTextColumn Binding="{Binding Count}" Header="计数" Width="72"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <DataGrid
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding RandomDistanceHistogramY}"
                                            Style="{StaticResource MaterialDesignDataGrid}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding BinIndex}" Header="Y 距离分箱" Width="100"/>
                                                <DataGridTextColumn Binding="{Binding MinValue, StringFormat={}{0:F1}}" Header="下限 (μm)" MinWidth="88" Width="*"/>
                                                <DataGridTextColumn Binding="{Binding MaxValue, StringFormat={}{0:F1}}" Header="上限 (μm)" MinWidth="88" Width="*"/>
                                                <DataGridTextColumn Binding="{Binding Count}" Header="计数" Width="72"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <DataGrid
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding RandomSpeedHistogramX}"
                                            Style="{StaticResource MaterialDesignDataGrid}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding BinIndex}" Header="X 速度分箱" Width="100"/>
                                                <DataGridTextColumn Binding="{Binding MinValue, StringFormat={}{0:F1}}" Header="下限 (μm/s)" MinWidth="96" Width="*"/>
                                                <DataGridTextColumn Binding="{Binding MaxValue, StringFormat={}{0:F1}}" Header="上限 (μm/s)" MinWidth="96" Width="*"/>
                                                <DataGridTextColumn Binding="{Binding Count}" Header="计数" Width="72"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <DataGrid
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding RandomSpeedHistogramY}"
                                            Style="{StaticResource MaterialDesignDataGrid}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding BinIndex}" Header="Y 速度分箱" Width="100"/>
                                                <DataGridTextColumn Binding="{Binding MinValue, StringFormat={}{0:F1}}" Header="下限 (μm/s)" MinWidth="96" Width="*"/>
                                                <DataGridTextColumn Binding="{Binding MaxValue, StringFormat={}{0:F1}}" Header="上限 (μm/s)" MinWidth="96" Width="*"/>
                                                <DataGridTextColumn Binding="{Binding Count}" Header="计数" Width="72"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="硬件状态诊断">
                            <TabControl ItemsSource="{Binding Motors}" Style="{StaticResource MaterialDesignNavigationRailTabControl}">
                                <TabControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type mm:FiveAxisModel}">
                                        <TextBlock Text="{Binding Name}" Margin="0,10"/>
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                                <TabControl.ContentTemplate>
                                    <DataTemplate DataType="{x:Type mm:FiveAxisModel}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="15,0,0,0">
                                            <UniformGrid Columns="4" Margin="10">
                                                <TextBlock Text="当前位置 (μm):" Foreground="Gray" VerticalAlignment="Center" Margin="5"/>
                                                <TextBlock Text="{Binding MotorModel.MotorParams.PosUm, StringFormat={}{0:F3}}" FontWeight="Bold" VerticalAlignment="Center"/>

                                                <TextBlock Text="回传速度 (μm/s):" Foreground="Gray" VerticalAlignment="Center" Margin="5"/>
                                                <TextBlock Text="{Binding MotorModel.MotorParams.FeedbackSpeedUm, StringFormat={}{0:F3}}" FontWeight="Bold" VerticalAlignment="Center"/>

                                                <TextBlock Text="计算速度 (μm/s):" Foreground="Gray" VerticalAlignment="Center" Margin="5"/>
                                                <TextBlock Text="{Binding MotorModel.MotorParams.CalculatedSpeedUm, StringFormat={}{0:F3}}" FontWeight="Bold" VerticalAlignment="Center"/>

                                                <TextBlock Text="控制模式:" Foreground="Gray" VerticalAlignment="Center" Margin="5"/>
                                                <TextBlock Text="{Binding MotorModel.MotorParams.CtrType}" VerticalAlignment="Center"/> 

                                                <TextBlock Text="使能状态:" Foreground="Gray" VerticalAlignment="Center" Margin="5"/>
                                                <TextBlock Text="{Binding MotorModel.MotorParams.Enable}" VerticalAlignment="Center"/>

                                                <TextBlock Text="运行状态:" Foreground="Gray" VerticalAlignment="Center" Margin="5"/>
                                                <TextBlock Text="{Binding MotorModel.MotorParams.MoveState}" VerticalAlignment="Center"/>

                                                <TextBlock Text="限位状态:" Foreground="Gray" VerticalAlignment="Center" Margin="5"/>
                                                <TextBlock Text="{Binding MotorModel.MotorParams.LimitedState}" Foreground="#ef5350" VerticalAlignment="Center"/>

                                                <TextBlock Text="轴类型:" Foreground="Gray" VerticalAlignment="Center" Margin="5"/>
                                                <TextBlock Text="{Binding MotorModel.MotorParams.MoveType}" VerticalAlignment="Center"/>

                                                <TextBlock Text="转换系数:" Foreground="Gray" VerticalAlignment="Center" Margin="5"/>
                                                <TextBlock Text="{Binding MotorModel.MotorParams.SubRatio}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            </UniformGrid>
                                        </ScrollViewer>
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                            </TabControl>
                        </TabItem>

                        <TabItem Header="测试结果报表">
                            <TabControl ItemsSource="{Binding Motors}" Style="{StaticResource MaterialDesignNavigationRailTabControl}">
                                <TabControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type mm:FiveAxisModel}">
                                        <TextBlock Text="{Binding Name}" Margin="0,10"/>
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                                <TabControl.ContentTemplate>
                                    <DataTemplate DataType="{x:Type mm:FiveAxisModel}">
                                        <DataGrid
                                            Margin="15,0,0,0"
                                            AlternatingRowBackground="#2F2F2F"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            CanUserDeleteRows="False"
                                            CanUserReorderColumns="False"
                                            CanUserResizeRows="False"
                                            GridLinesVisibility="All"
                                            HeadersVisibility="Column"
                                            HorizontalGridLinesBrush="#3A3A3A"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding MotorTestMessages}"
                                            RowBackground="#262626"
                                            RowHeaderWidth="0"
                                            MinRowHeight="56"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            VerticalGridLinesBrush="#3A3A3A"
                                            Style="{StaticResource MaterialDesignDataGrid}">
                                            <DataGrid.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="Padding" Value="10,8" />
                                                    <Setter Property="BorderBrush" Value="#3A3A3A" />
                                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                                    <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                                    <Setter Property="VerticalContentAlignment" Value="Top" />
                                                </Style>
                                            </DataGrid.CellStyle>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Width="1.3*" Header="测试项目">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding TestProject}" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Width="120" Header="状态">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border MinWidth="78" Padding="8,2" CornerRadius="10" HorizontalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#5A5A5A" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ProgressState}" Value="{x:Static mm:MotorTestProgressState.Running}">
                                                                                <Setter Property="Background" Value="#1976D2" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding ProgressState}" Value="{x:Static mm:MotorTestProgressState.Passed}">
                                                                                <Setter Property="Background" Value="#2E7D32" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding ProgressState}" Value="{x:Static mm:MotorTestProgressState.Failed}">
                                                                                <Setter Property="Background" Value="#C62828" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock HorizontalAlignment="Center" Foreground="White">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="待测" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ProgressState}" Value="{x:Static mm:MotorTestProgressState.Running}">
                                                                                    <Setter Property="Text" Value="进行中" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding ProgressState}" Value="{x:Static mm:MotorTestProgressState.Passed}">
                                                                                    <Setter Property="Text" Value="合格" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding ProgressState}" Value="{x:Static mm:MotorTestProgressState.Failed}">
                                                                                    <Setter Property="Text" Value="不合格" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Width="1.7*" Header="标准值">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Margin="2,0,8,0" Text="{Binding StandardValue}" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Width="1.9*" Header="测量值">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Margin="2,0,8,0" Text="{Binding TestValue}" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Width="2.1*" Header="说明">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Margin="2,0,12,0" Opacity="0.92" Text="{Binding Description}" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                            </TabControl>
                        </TabItem>

                        <TabItem Header="实时日志">
                            <TabControl ItemsSource="{Binding Motors}" Style="{StaticResource MaterialDesignNavigationRailTabControl}">
                                <TabControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type mm:FiveAxisModel}">
                                        <TextBlock Text="{Binding Name}" Margin="0,10"/>
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                                <TabControl.ContentTemplate>
                                    <DataTemplate DataType="{x:Type mm:FiveAxisModel}">
                                        <ListView ItemsSource="{Binding Log}" Style="{StaticResource MaterialDesignListView}" Margin="15,0,0,0">
                                            <ListView.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="清除日志" Command="{Binding ClearLogCommand}"/>
                                                </ContextMenu>
                                            </ListView.ContextMenu>
                                        </ListView>
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                            </TabControl>
                        </TabItem>
                    </TabControl>
                </md:Card>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="2" Background="{DynamicResource PrimaryHueLightBrush}" Foreground="{DynamicResource PrimaryHueLightForegroundBrush}">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="X轴:" Margin="0,0,6,0" Opacity="0.9"/>
                    <ProgressBar Value="{Binding XProgressValue}" Width="140" Height="10" Style="{StaticResource MaterialDesignLinearProgressBar}"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Style="{StaticResource MaterialDesignLightSeparator}"/>
            <StatusBarItem>
                <TextBlock Text="{Binding XProgressValue, StringFormat=X轴: {0:F0}%}" FontWeight="SemiBold"/>
            </StatusBarItem>
            <Separator Style="{StaticResource MaterialDesignLightSeparator}"/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Y轴:" Margin="0,0,6,0" Opacity="0.9"/>
                    <ProgressBar Value="{Binding YProgressValue}" Width="140" Height="10" Style="{StaticResource MaterialDesignLinearProgressBar}"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Style="{StaticResource MaterialDesignLightSeparator}"/>
            <StatusBarItem>
                <TextBlock Text="{Binding YProgressValue, StringFormat=Y轴: {0:F0}%}" FontWeight="SemiBold"/>
            </StatusBarItem>
            <Separator Style="{StaticResource MaterialDesignLightSeparator}"/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="软件版本: " Opacity="0.8"/>
                    <TextBlock Text="{Binding Version}" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Style="{StaticResource MaterialDesignLightSeparator}"/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="已捕捉数据点: " Opacity="0.8"/>
                    <TextBlock Text="{Binding TotalSize}" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>