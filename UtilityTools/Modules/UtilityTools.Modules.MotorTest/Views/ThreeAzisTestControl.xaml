                    <TabItem Header="x日志信息">
                        <DockPanel LastChildFill="True">
                            <ListView ItemsSource="{Binding XAxis.Log}"
                                      VerticalAlignment="Top">
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="清除" Command="{Binding ClearLogCommand}"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                            </ListView>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="y日志信息">
                        <DockPanel LastChildFill="True">
                            <ListView ItemsSource="{Binding YAxis.Log}"
                                      VerticalAlignment="Top">
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="清除" Command="{Binding ClearLogCommand}"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                            </ListView>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="z日志信息">
                        <DockPanel LastChildFill="True">
                            <ListView ItemsSource="{Binding ZAxis.Log}"
                                      VerticalAlignment="Top">
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="清除" Command="{Binding ClearLogCommand}"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                            </ListView>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="t日志信息">
                        <DockPanel LastChildFill="True">
                            <ListView ItemsSource="{Binding TAxis.Log}"
                                      VerticalAlignment="Top">
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="清除" Command="{Binding ClearLogCommand}"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                            </ListView>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="r日志信息">
