        </TabControl >

        <Grid  Grid.Row="1" Cursor="">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 最外层椭圆，作为背景容器 -->
            <Ellipse Width="200" Height="200" Fill="#FF333333"/>
            <Grid Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 中间显示区域的椭圆 -->
                <Ellipse Fill="#FF444444" Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="0" Color="Black"/>
                    </Ellipse.Effect>
                </Ellipse>
                <!-- 用于显示角度等信息的文本块 -->
                <Button Content="停止" Style="{StaticResource CircleButtonStyle}"  Command="{Binding MoveCommand}" CommandParameter="stop" FontSize="20" FontWeight="Bold" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Height="80" Width="80"/>
                <!-- 布局网格，划分四个方向区域 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 上按钮 -->
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource DirectionButtonStyle}" Command="{Binding MoveCommand}" CommandParameter="y_p">
                        <Path Data="M 0,5 L 5,0 L 10,5" Stroke="White" StrokeThickness="5"/>
                    </Button>
                    <!-- 左按钮 -->
                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource DirectionButtonStyle}" Command="{Binding MoveCommand}" CommandParameter="x_n">
                        <Path Data="M 5,0 L 0,5 L 5,10" Stroke="White" StrokeThickness="5"/>
                    </Button>
                    <!-- 下按钮 -->
                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource DirectionButtonStyle}" Command="{Binding MoveCommand}" CommandParameter="y_n">
                        <Path Data="M 0,5 L 5,10 L 10,5" Stroke="White" StrokeThickness="5"/>
                    </Button>
                    <!-- 右按钮 -->
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource DirectionButtonStyle}" Command="{Binding MoveCommand}" CommandParameter="x_p">
                        <Path Data="M 5,0 L 10,5 L 5,10" Stroke="White" StrokeThickness="5"/>
                    </Button>
                </Grid>
            </Grid>
        
            <UniformGrid Columns="2" Grid.Column="1">
                <RadioButton  Content="使用速度模式" IsChecked="{Binding IsSpeedMode}"/>
                <RadioButton  Content="使用位置模式" IsChecked="True"/>
                <Button Content="z轴正方向"  Command="{Binding MoveCommand}" CommandParameter="z_p" Margin="10"/>
                <Button Content="z轴负方向" Command="{Binding MoveCommand}" CommandParameter="z_n" Margin="10"/>
                <Button Content="r轴正方向"  Command="{Binding MoveCommand}" CommandParameter="r_p" Margin="10"/>
                <Button Content="r轴负方向" Command="{Binding MoveCommand}" CommandParameter="r_n" Margin="10"/>
                <Button Content="t轴正方向"  Command="{Binding MoveCommand}" CommandParameter="t_p" Margin="10"/>
                <Button Content="t轴负方向" Command="{Binding MoveCommand}" CommandParameter="t_n" Margin="10"/>
            </UniformGrid>




          
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1">
            <TabControl>
                <TabItem Header="功能测试">
                    <StackPanel >
                        <UniformGrid Columns="4" >
                            <Button Content="基础测试" Command="{Binding TestMotorDelegateCommand}" CommandParameter="all" Margin="10"/>
                            <Button Content="x基础测试" Command="{Binding TestMotorDelegateCommand}" CommandParameter="x" Margin="10"/>
                            <Button Content="y基础测试" Command="{Binding TestMotorDelegateCommand}" CommandParameter="y" Margin="10"/>
                            <Button Content="z基础测试" Command="{Binding TestMotorDelegateCommand}" CommandParameter="z" Margin="10"/>
                            <Button Content="t基础测试" Command="{Binding TestMotorDelegateCommand}" CommandParameter="t" Margin="10"/>
                            <Button Content="r基础测试" Command="{Binding TestMotorDelegateCommand}" CommandParameter="r" Margin="10"/>
                            <Button Content="丝杆测试" Command="{Binding SmoothnessDetectionCommand}" CommandParameter="all" Margin="10"/>
                            <Button Content="x丝杆测试" Command="{Binding SmoothnessDetectionCommand}" CommandParameter="x" Margin="10"/>
                            <Button Content="y丝杆测试" Command="{Binding SmoothnessDetectionCommand}" CommandParameter="y" Margin="10"/>
                            <Button Content="z丝杆测试" Command="{Binding SmoothnessDetectionCommand}" CommandParameter="z" Margin="10"/>
                            <Button Content="t丝杆测试" Command="{Binding SmoothnessDetectionCommand}" CommandParameter="t" Margin="10"/>
                            <Button Content="r丝杆测试" Command="{Binding SmoothnessDetectionCommand}" CommandParameter="r" Margin="10"/>
                            <Button Content="数据库测试" Command="{Binding SQLiteTestCommand}" Margin="10"/>
                            <Button Content="开启性能模式" Command="{Binding TestPerformanceCommand}" Margin="10"/>
                            <Button Content="关闭性能模式" Command="{Binding CloseTestPerformanceCommand}" Margin="10"/>
                            <Button Content="保存数据" Command="{Binding SaveDataFileCommand}" Margin="10"/>
                            <Button Content="加载数据" Command="{Binding ReadDataFileCommand}" Margin="10"/>
                            <Button Content="关闭xyz软限位" Command="{Binding CloseSlimitedCommand}" Margin="10"/>
                        </UniformGrid>
                    </StackPanel>
                </TabItem>
                <TabItem Header="电机状态">
                    <TabControl>
                        <TabItem Header="x轴">
                            <UniformGrid Columns="4">
                                <Label Content="位置（脉冲）"/>
                                <Label Content="{Binding XAxis.MotorModel.MotorParams.Pos}" />
                                <Label Content="速度（脉冲/s）"/>
                                <Label Content="{Binding XAxis.MotorModel.MotorParams.Speed}" />
                                <Label Content="控制模式"/>
                                <Label Content="{Binding XAxis.MotorModel.MotorParams.CtrType}"/>
                                <Label Content="使能状态"/>
                                <Label Content="{Binding XAxis.MotorModel.MotorParams.Enable}"/>
                                <Label Content="运行状态"/>
                                <Label Content="{Binding XAxis.MotorModel.MotorParams.MoveState}"/>
                                <Label Content="运行方向"/>
                                <Label Content="{Binding XAxis.MotorModel.MotorParams.MoveDirection}"/>
                                <Label Content="限位状态"/>
                                <Label Content="{Binding XAxis.MotorModel.MotorParams.LimitedState}"/>
                                <Label Content="软正限位状态"/>
                                <Label Content="{Binding XAxis.MotorModel.MotorParams.SPLimted}"/>
                                <Label Content="软负限位状态"/>
                                <Label Content="{Binding XAxis.MotorModel.MotorParams.SNLimted}"/>
                                <Label Content="轴类型"/>
