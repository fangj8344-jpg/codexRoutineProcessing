                                <Label Content="{Binding RAxis.MotorModel.MotorParams.MoveType}"/>
                                <Label Content="转换系数"/>
                                <Label Content="{Binding RAxis.MotorModel.MotorParams.SubRatio}"/>
                            </UniformGrid>
                        </TabItem>
                    </TabControl>
                   
                </TabItem>
            </TabControl>

        </Grid>
    </Grid>
</UserControl>
