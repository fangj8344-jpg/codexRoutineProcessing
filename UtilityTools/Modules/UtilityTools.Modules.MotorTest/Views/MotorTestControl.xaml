<UserControl x:Class="UtilityTools.Modules.MotorTest.Views.MotorTestControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UtilityTools.Modules.MotorTest.Views"
             xmlns:oxy="http://oxyplot.org/wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- 方向按钮的样式 -->
        <Style x:Key="DirectionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="LightGray"/>
                </Trigger>
                <!-- 鼠标按下时的样式 -->
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <!-- 点击时背景变深 -->
                    <Setter Property="Foreground" Value="#333333"/>
                    <Setter Property="BorderBrush" Value="#999999"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                            <!-- 点击时略微缩小 -->
                        </Setter.Value>
                    </Setter>
                    </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- 圆形背景 -->
                            <Ellipse x:Name="BackgroundEllipse"
                             Fill="{TemplateBinding Background}"
                             Stroke="{TemplateBinding BorderBrush}"
                             StrokeThickness="{TemplateBinding BorderThickness}"/>

                            <!-- 按钮内容 -->
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                        </Grid>

                        <!-- 鼠标悬停和点击效果 -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundEllipse" Property="Fill" Value="#FF6666"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackgroundEllipse" Property="Fill" Value="#FF3333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TabControl>
            <TabItem Header="速度曲线图">
                <oxy:PlotView Model="{Binding MotorSpeedplotModel}"  Grid.Row="0" Grid.Column="0">
                    <oxy:PlotView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="自适应"
                                      Command="{Binding AutoAdjustCommand}" />
                            <MenuItem Header="清除"
                                      Command="{Binding ClearMonitorCommand}" />
                            <MenuItem Header="另存为"
                                      Command="{Binding SaveMonitorInfoCommand}" />
                        </ContextMenu>
                    </oxy:PlotView.ContextMenu>
                </oxy:PlotView>
            </TabItem>
            <TabItem Header="位置曲线图">
                <oxy:PlotView Model="{Binding MotorplotModel}"  Grid.Row="0" Grid.Column="0">
                    <oxy:PlotView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="自适应"
                                      Command="{Binding AutoAdjustCommand}" />
                            <MenuItem Header="清除"
                                      Command="{Binding ClearMonitorCommand}" />
                            <MenuItem Header="另存为"
                                      Command="{Binding SaveMonitorInfoCommand}" />
                        </ContextMenu>
                    </oxy:PlotView.ContextMenu>
                </oxy:PlotView>
            </TabItem>
        </TabControl>
        <TabControl  Grid.Row="0" Grid.Column="1" >
            <TabItem Header="测试结果">
                <DataGrid   AutoGenerateColumns="False" IsReadOnly="True"   Margin="50,0,50,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="测试项目" Binding ="{Binding MotorTestMessages.TestProject}" />
                        <DataGridTextColumn Header="测试结果" Binding="{Binding MotorTestMessages.TestResult}"/>
                        <DataGridTextColumn Header="测量值" Binding="{Binding MotorTestMessages.TestValue}"/>
                        <DataGridTextColumn Header="标准值" Binding="{Binding MotorTestMessages.StandardValue}"/>
                        <DataGridTextColumn Header="说明" Binding="{Binding MotorTestMessages.Description}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="日志信息">
                <ListView ItemsSource="{Binding Log}"   VerticalAlignment="Top">
                </ListView>
            </TabItem>
        </TabControl >
        
        <Grid  Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 最外层椭圆，作为背景容器 -->
            <Ellipse Width="200" Height="200" Fill="#FF333333"/>
            <Grid Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 中间显示区域的椭圆 -->
                <Ellipse Fill="#FF444444" Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="0" Color="Black"/>
                    </Ellipse.Effect>
                </Ellipse>
                <!-- 用于显示角度等信息的文本块 -->
                <Button Content="停止" Style="{StaticResource CircleButtonStyle}"  FontSize="20" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Height="80" Width="80"/>
                <!-- 布局网格，划分四个方向区域 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 上按钮 -->
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource DirectionButtonStyle}" Command="{Binding MoveCommand}" CommandParameter="up">
                        <Path Data="M 0,5 L 5,0 L 10,5" Stroke="White" StrokeThickness="5"/>
                    </Button>
                    <!-- 左按钮 -->
                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource DirectionButtonStyle}" Command="{Binding MoveCommand}" CommandParameter="left">
                        <Path Data="M 5,0 L 0,5 L 5,10" Stroke="White" StrokeThickness="5"/>
                    </Button>
                    <!-- 下按钮 -->
                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource DirectionButtonStyle}" Command="{Binding MoveCommand}" CommandParameter="dowm">
                        <Path Data="M 0,5 L 5,10 L 10,5" Stroke="White" StrokeThickness="5"/>
                    </Button>
                    <!-- 右按钮 -->
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource DirectionButtonStyle}" Command="{Binding MoveCommand}" CommandParameter="right">
                        <Path Data="M 5,0 L 10,5 L 5,10" Stroke="White" StrokeThickness="5"/>
                    </Button>
                </Grid>
            </Grid>
            <Grid Grid.Column="1">
                <DockPanel Margin="0,80,0,0">
                    <Label Content="x:" Margin="20,0,0,0"/>
                    <Label Content="0.00:" />
                    <Label Content="脉冲" />
                    <Label Content="y:" Margin="20,0,0,0"/>
                    <Label Content="0.00:" />
                    <Label Content="脉冲" Margin="0,0,20,0" />
             
                </DockPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1">
            <StackPanel >
                <Button Content="开始测试" Command="{Binding TestAllCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
