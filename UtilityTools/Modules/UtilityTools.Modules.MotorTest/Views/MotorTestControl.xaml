<UserControl x:Class="UtilityTools.Modules.MotorTest.Views.MotorTestControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UtilityTools.Modules.MotorTest.Views"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:bh="clr-namespace:UtilityTools.Core.Behavior;assembly=UtilityTools.Core"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- 方向按钮的样式 -->
        <Style x:Key="DirectionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="LightGray"/>
                </Trigger>
                <!-- 鼠标按下时的样式 -->
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <!-- 点击时背景变深 -->
                    <Setter Property="Foreground" Value="#333333"/>
                    <Setter Property="BorderBrush" Value="#999999"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                            <!-- 点击时略微缩小 -->
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- 圆形背景 -->
                            <Ellipse x:Name="BackgroundEllipse"
                             Fill="{TemplateBinding Background}"
                             Stroke="{TemplateBinding BorderBrush}"
                             StrokeThickness="{TemplateBinding BorderThickness}"/>

                            <!-- 按钮内容 -->
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                        </Grid>

                        <!-- 鼠标悬停和点击效果 -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundEllipse" Property="Fill" Value="#FF6666"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackgroundEllipse" Property="Fill" Value="#FF3333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TabControl>
            <TabItem Header="位置曲线图">
                <oxy:PlotView Model="{Binding MotorplotModel}"  Grid.Row="0" Grid.Column="0"  Foreground="Black" >
                    <oxy:PlotView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="自适应"
                          Command="{Binding AutoAdjustCommand}"  CommandParameter="point" />
                            <MenuItem Header="清除"
                          Command="{Binding ClearMonitorCommand}"  CommandParameter="point"/>
                            <MenuItem Header="另存为"
                          Command="{Binding SaveToFileCommand}" CommandParameter="point" />
                        </ContextMenu>
                    </oxy:PlotView.ContextMenu>
                </oxy:PlotView>
            </TabItem>
            <TabItem Header="速度曲线图">
                <oxy:PlotView Model="{Binding MotorSpeedplotModel}"  Grid.Row="0" Grid.Column="0" Foreground="Black">
                    <oxy:PlotView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="自适应"
                                      Command="{Binding AutoAdjustCommand}"  CommandParameter="speed"/>
                            <MenuItem Header="清除"
                                      Command="{Binding ClearMonitorCommand}"  CommandParameter="speed"/>
                            <MenuItem Header="另存为"
                                      Command="{Binding SaveToFileCommand}" CommandParameter="speed" />
                        </ContextMenu>
                    </oxy:PlotView.ContextMenu>
                </oxy:PlotView>
            </TabItem>

        </TabControl>
        <TabControl  Grid.Row="0" Grid.Column="1" >
            <TabItem Header="测试结果">
                <DataGrid   AutoGenerateColumns="False" IsReadOnly="True"   Margin="50,0,50,0" ItemsSource="{Binding MotorTestMessages}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="测试项目" Binding ="{Binding TestProject}" />
                        <DataGridTextColumn Header="测试结果" Binding="{Binding TestResult}"/>
                        <DataGridTextColumn Header="测量值" Binding="{Binding TestValue}"/>
                        <DataGridTextColumn Header="标准值" Binding="{Binding StandardValue}"/>
                        <DataGridTextColumn Header="说明" Binding="{Binding Description}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="日志信息">
                <DockPanel LastChildFill="True">
                    <ListView ItemsSource="{Binding Log}"
                              VerticalAlignment="Top">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="清除" Command="{Binding ClearLogCommand}"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>

                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl >

        <Grid  Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 最外层椭圆，作为背景容器 -->
            <Ellipse Width="200" Height="200" Fill="#FF333333"/>
            <Grid Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 中间显示区域的椭圆 -->
                <Ellipse Fill="#FF444444" Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="0" Color="Black"/>
                    </Ellipse.Effect>
                </Ellipse>
                <!-- 用于显示角度等信息的文本块 -->
                <Button Content="停止" Style="{StaticResource CircleButtonStyle}"  Command="{Binding MoveCommand}" CommandParameter="stop" FontSize="20" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Height="80" Width="80"/>
                <!-- 布局网格，划分四个方向区域 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 上按钮 -->
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource DirectionButtonStyle}" Command="{Binding MoveCommand}" CommandParameter="up">
                        <Path Data="M 0,5 L 5,0 L 10,5" Stroke="White" StrokeThickness="5"/>
                    </Button>
                    <!-- 左按钮 -->
                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource DirectionButtonStyle}" Command="{Binding MoveCommand}" CommandParameter="left">
                        <Path Data="M 5,0 L 0,5 L 5,10" Stroke="White" StrokeThickness="5"/>
                    </Button>
                    <!-- 下按钮 -->
                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource DirectionButtonStyle}" Command="{Binding MoveCommand}" CommandParameter="down">
                        <Path Data="M 0,5 L 5,10 L 10,5" Stroke="White" StrokeThickness="5"/>
                    </Button>
                    <!-- 右按钮 -->
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource DirectionButtonStyle}" Command="{Binding MoveCommand}" CommandParameter="right">
                        <Path Data="M 5,0 L 10,5 L 5,10" Stroke="White" StrokeThickness="5"/>
                    </Button>
                </Grid>
            </Grid>
            <Grid Grid.Column="1">
                <StackPanel>
                    <DockPanel Margin="0,80,0,0">
                        <Label Content="x:" Margin="20,0,0,0"/>
                        <Label Content="{Binding MotorModelX.MotorParams.Pos}" />
                        <Label Content=" 脉冲" />
                        <Label Content="y:" Margin="20,0,0,0"/>
                        <Label Content="{Binding MotorModelY.MotorParams.Pos}" />
                        <Label Content=" 脉冲" Margin="0,0,20,0" />
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <Label Content="x:" Margin="20,0,0,0"/>
                        <Label Content="{Binding MotorModelX.MotorParams.Speed}" />
                        <Label Content=" 脉冲/s" />
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <Label Content="y:" Margin="20,0,0,0"/>
                        <Label Content="{Binding MotorModelY.MotorParams.Speed}" />
                        <Label Content=" 脉冲/s" Margin="0,0,20,0" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1">
            <TabControl>
                <TabItem Header="功能测试">
                    <StackPanel >
                        <UniformGrid Columns="4" >
                            <Button Content="基础测试" Command="{Binding TestAllCommand}" Margin="10"/>
                            <Button Content="丝杆性能测试" Command="{Binding TestSmoothnessDetectionCommand}" CommandParameter="open" Margin="10"/>
                            <Button Content="关闭丝杆测试" Command="{Binding}" CommandParameter="close" Margin="10"/>
                            <Button Content="设中心零点" Command="{Binding AutomaticZeroInitializationCommand}" Margin="10"/>
                            <Button Content="使用软限位" Command="{Binding SetMotorLimitEnableCommand}" CommandParameter="true" Margin="10" />
                            <Button Content="取消软限位" Command="{Binding SetMotorLimitEnableCommand}" CommandParameter="false" Margin="10" />
                            <Button Content="测试极限性能" Command="{Binding TestPerformanceCommand}" Margin="10"/>
                            <Button Content="关闭极限性能" Command="{Binding NoPerformanceCommand}" Margin="10"/>
                            <Button Content="保存" Command="{Binding SerilizeCommand}" Margin="10"/>
                            <Button Content="加载" Command="{Binding DeserilizeCommand}" Margin="10"/>
                            <Button Content="五轴测试" Command="{Binding ShowThreeAzisTestModelViewModelCommand}" Margin="10"/>
                            <Button Content="耐久测试" Command="{Binding DurabilityTestgCommand}" Margin="10"/>
                            <Button Content="关闭耐度测试" Command="{Binding ShutDownDurabilityTestCommand}" Margin="10"/>
                        </UniformGrid>
                    </StackPanel>
                </TabItem>
                <TabItem Header="电机状态">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="11*"/>
                            <ColumnDefinition Width="25*"/>
                            <ColumnDefinition Width="161*"/>
                            <ColumnDefinition Width="197*"/>
                        </Grid.ColumnDefinitions>
                        <UniformGrid Columns="2" Rows="8" Grid.ColumnSpan="3">
                            <Label Content="x轴电机信息"/>
                            <Label/>
                            <Label Content="控制模式"/>
                            <Label Content="{Binding MotorModelX.MotorParams.CtrType}"/>
                            <Label Content="使能状态"/>
                            <Label Content="{Binding MotorModelX.MotorParams.Enable}"/>
                            <Label Content="运行状态"/>
                            <Label Content="{Binding MotorModelX.MotorParams.MoveState}"/>
                            <Label Content="运行方向"/>
                            <Label Content="{Binding MotorModelX.MotorParams.MoveDirection}"/>
                            <Label Content="限位状态"/>
                            <Label Content="{Binding MotorModelX.MotorParams.LimitedState}"/>
                            <Label Content="软正限位状态"/>
                            <Label Content="{Binding MotorModelX.MotorParams.SPLimted}"/>
                            <Label Content="软负限位状态"/>
                            <Label Content="{Binding MotorModelX.MotorParams.SNLimted}"/>
                        </UniformGrid>
                        <UniformGrid Columns="2" Rows="8" Grid.Column="3">
                            <Label Content="y轴电机信息"/>
                            <Label />
                            <Label Content="控制模式"/>
                            <Label Content="{Binding MotorModelY.MotorParams.CtrType}"/>
                            <Label Content="使能状态"/>
                            <Label Content="{Binding MotorModelY.MotorParams.Enable}"/>
                            <Label Content="运行状态"/>
                            <Label Content="{Binding MotorModelY.MotorParams.MoveState}"/>
                            <Label Content="运行方向"/>
                            <Label Content="{Binding MotorModelY.MotorParams.MoveDirection}"/>
                            <Label Content="限位状态"/>
                            <Label Content="{Binding MotorModelY.MotorParams.LimitedState}"/>
                            <Label Content="软正限位状态"/>
                            <Label Content="{Binding MotorModelY.MotorParams.SPLimted}"/>
                            <Label Content="软负限位状态"/>
                            <Label Content="{Binding MotorModelY.MotorParams.SNLimted}"/>
                        </UniformGrid>
                    </Grid>
                </TabItem>
            </TabControl>

        </Grid>
    </Grid>
</UserControl>
