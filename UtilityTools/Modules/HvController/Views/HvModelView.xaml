<UserControl x:Class="UtilityTools.Modules.HvController.Views.HvModelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UtilityTools.Modules.HvController.Views"
             xmlns:attach="clr-namespace:UtilityTools.Core.Attach;assembly=UtilityTools.Core"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:cv="clr-namespace:UtilityTools.Core.Converter;assembly=UtilityTools.Core"
             xmlns:xc="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <cv:BoolToVisibilityConverter x:Key="boolToVisibilityConverter" />
        <cv:EnumDescriptionConverter x:Key="enumDescriptionConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   LastChildFill="True">

            <DockPanel DockPanel.Dock="Left"
                       LastChildFill="True"
                       Width="400"
                       Margin="0, 0, 10, 0">
                <ListView ItemsSource="{Binding Logs}"
                          DockPanel.Dock="Bottom"
                          Height="300">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="通讯日志"
                                            Width="380"
                                            DisplayMemberBinding="{Binding }" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <DataGrid AutoGenerateColumns="False"
                          ItemsSource="{Binding CustomCmds}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="自动发送"
                                                Binding="{Binding IsAutoSend}" />
                        <DataGridTextColumn Header="消息报文-16进制发送"
                                            Binding="{Binding CmdString}"
                                            IsReadOnly="False" />
                        <DataGridTemplateColumn Header="单次发送">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="发送"
                                            Command="{Binding SendCmdStringCommand}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <Grid DockPanel.Dock="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Label Content="加速电压"
                       Grid.Row="0"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center" />

                <Label Content="发射电流"
                       Grid.Row="0"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center" />

                <Label Content="灯丝电阻"
                       Grid.Row="0"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center" />

                <Label Content="栅极电压"
                       Grid.Row="0"
                       Grid.Column="3"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center" />

                <Label Content="{Binding ReadAccVol}"
                       Foreground="LightBlue"
                       Grid.Row="1"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center" />

                <Label Content="{Binding ReadEmissCur}"
                       Foreground="LightBlue"
                       Grid.Row="1"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center" />

                <Label Content="{Binding ReadFilaR}"
                       Foreground="LightBlue"
                       Grid.Row="1"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center" />

                <Label Content="{Binding ReadGridVol}"
                       Foreground="LightBlue"
                       Grid.Row="1"
                       Grid.Column="3"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center" />

                <Label Content="物理地址"
                       Grid.Row="2"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center" />

                <Label Content="灯丝参数"
                       Grid.Row="2"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center" />

                <Label Content="使用时间"
                       Grid.Row="2"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center" />

                <Label Content="灯丝类型"
                       Grid.Row="2"
                       Grid.Column="3"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center" />

                <Label Content="{Binding ReadRegAddr}"
                       Foreground="LightBlue"
                       Grid.Row="3"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center" />

                <Label Content="{Binding ReadFilaParam}"
                       Foreground="LightBlue"
                       Grid.Row="3"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center" />

                <Label Content="{Binding ReadFilaUsedTime}"
                       Foreground="LightBlue"
                       Grid.Row="3"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center" />

                <Label Content="{Binding ReadFilaType, Converter={StaticResource enumDescriptionConverter}}"
                       Foreground="LightBlue"
                       Grid.Row="3"
                       Grid.Column="3"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center" />

                <oxy:PlotView Model="{Binding HvPlotModel}"
                              Grid.Row="4"
                              Grid.ColumnSpan="4">
                    <oxy:PlotView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="加载"
                                      Command="{Binding LoadMonitorInfoCommand}" />
                            <MenuItem Header="另存为"
                                      Command="{Binding SaveMonitorInfoCommand}" />
                            <MenuItem Header="清除"
                                      Command="{Binding ClearMonitorCommand}" />
                        </ContextMenu>
                    </oxy:PlotView.ContextMenu>
                </oxy:PlotView>
            </Grid>
        </DockPanel>

        <DockPanel Grid.Row="2"
                   Margin="10"
                   LastChildFill="False">
            <Label Content="采样间隔(ms):"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   DockPanel.Dock="Left"
                   Margin="5, 0, 5, 0" />
            <TextBox Text="{Binding MonitorInterval}"
                     VerticalAlignment="Center"
                     Padding="10, 0, 12, 0"
                     attach:TextBoxAttached.IsEnterEndEdit="True"
                     attach:TextBoxAttached.IsOnlyNumbers="True"
                     attach:TextBoxAttached.IsSupportWheel="True"
                     DockPanel.Dock="Left"
                     Margin="5, 0, 5, 0" />
            <Button DockPanel.Dock="Left"
                    Command="{Binding ChangeMonitorStateCommand}"
                    Content="{Binding MonitorState}"
                    Margin="5, 0, 5, 0" />

            <TextBox Text="{Binding UserParam4, StringFormat=0x{0:X2}}"
                     VerticalAlignment="Center"
                     Padding="10, 0, 12, 0"
                     Margin="5, 0, 5, 0"
                     DockPanel.Dock="Right" />

            <TextBox Text="{Binding UserParam3, StringFormat=0x{0:X2}}"
                     VerticalAlignment="Center"
                     Padding="10, 0, 12, 0"
                     Margin="5, 0, 5, 0"
                     DockPanel.Dock="Right" />

            <TextBox Text="{Binding UserParam2, StringFormat=0x{0:X2}}"
                     VerticalAlignment="Center"
                     Padding="10, 0, 12, 0"
                     Margin="5, 0, 5, 0"
                     DockPanel.Dock="Right" />

            <TextBox Text="{Binding UserParam1, StringFormat=0x{0:X2}}"
                     VerticalAlignment="Center"
                     Padding="10, 0, 12, 0"
                     Margin="5, 0, 5, 0"
                     DockPanel.Dock="Right" />

            <Button Content="参数设置"
                    Command="{Binding SetUserParamCommand}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Margin="5, 0, 5, 0" />

            <Button Content="参数查询"
                    Command="{Binding ReadRegisterCommand}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Margin="5, 0, 5, 0" />

        </DockPanel>

        <DockPanel Grid.Row="1"
                   Margin="10"
                   LastChildFill="False">
            <Button Content="设置高压(kV):"
                    Command="{Binding SetAccVolCommand}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Margin="5, 0, 5, 0" />
            <TextBox Text="{Binding SetAccVol}"
                     VerticalAlignment="Center"
                     Padding="10, 0, 12, 0"
                     attach:TextBoxAttached.IsEnterEndEdit="True"
                     attach:TextBoxAttached.IsOnlyNumbers="True"
                     attach:TextBoxAttached.IsSupportWheel="True"
                     DockPanel.Dock="Left"
                     Margin="5, 0, 5, 0" />
            <Button Content="高压切换(kV):"
                    Command="{Binding ChangeHvCommand}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Margin="5, 0, 5, 0" />
            <TextBox Text="{Binding ChangeAccVol}"
                     VerticalAlignment="Center"
                     Padding="10, 0, 12, 0"
                     attach:TextBoxAttached.IsEnterEndEdit="True"
                     attach:TextBoxAttached.IsOnlyNumbers="True"
                     attach:TextBoxAttached.IsSupportWheel="True"
                     DockPanel.Dock="Left"
                     Margin="5, 0, 5, 0" />

            <Button Content="恢复重置"
                    Command="{Binding ReDefaultCommand}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Margin="5, 0, 5, 0" />

            <Button Content="清除错误"
                    Command="{Binding ClearErrorCommand}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Margin="5, 0, 5, 0" />

            <Button Content="关闭高压"
                    Command="{Binding CloseHvCommand}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Margin="5, 0, 5, 0" />

            <Button Content="开启高压"
                    Command="{Binding OpenHvCommand}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Margin="5, 0, 5, 0" />

            <CheckBox Content="新灯丝"
                      VerticalAlignment="Center"
                      DockPanel.Dock="Right"
                      IsChecked="{Binding IsNewFila}" />
        </DockPanel>
    </Grid>
</UserControl>
