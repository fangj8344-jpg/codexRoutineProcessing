<UserControl x:Class="UtilityTools.Modules.FlyDataTool.Views.FlyDataToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UtilityTools.Modules.FlyDataTool.Views"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:cv="clr-namespace:UtilityTools.Core.Converter;assembly=UtilityTools.Core"
             xmlns:oxy="http://oxyplot.org/wpf"
             Foreground="Black"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <cv:SecondsToHMSConverter x:Key="secondsToHMSConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Margin="2">
            <Button Content="选择文件"
                    Margin="5"
                    Command="{Binding SelectFileCommand}"
                    DockPanel.Dock="Left" />

            <Button Content="保存图像"
                    Command="{Binding SavePlotCommand}"
                    Margin="5"
                    DockPanel.Dock="Right" />
            <Button Content="显示全数据"
                    Command="{Binding SelectAllFlyDataCommand}"
                    DockPanel.Dock="Right" />

            <TextBlock Text="{Binding FilePath}"
                       Foreground="White"
                       VerticalAlignment="Center" />
        </DockPanel>

        <oxy:PlotView Grid.Row="1"
                      Name="plotView"
                      Model="{Binding FlyDataPlotModel}">
            <oxy:PlotView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="自适应"
                              Command="{Binding PlotAutoAdjustCommand}"
                              CommandParameter="ImageParam" />
                    <CheckBox Content="坐标轴切换"
                              IsChecked="{Binding IsAxisXShift}" />
                </ContextMenu>
            </oxy:PlotView.ContextMenu>
        </oxy:PlotView>


        <GridSplitter Grid.Row="2"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ShowsPreview="True"
                      Background="Black"
                      Height="5" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <DataGrid Grid.Column="0"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      ItemsSource="{Binding FlyDataModels}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="采集时间"
                                        Width="2*"
                                        Binding="{Binding Time, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}" />
                    <DataGridTextColumn Header="加速电压"
                                        Width="*"
                                        Binding="{Binding AccVol}" />
                    <DataGridTextColumn Header="灯丝电流"
                                        Width="*"
                                        Binding="{Binding FilaCur}" />
                    <DataGridTextColumn Header="灯丝电阻"
                                        Width="*"
                                        Binding="{Binding FilaR}" />
                    <DataGridTextColumn Header="栅极电压"
                                        Width="*"
                                        Binding="{Binding GridVol}" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ShowsPreview="True"
                          Background="Black"
                          Width="5" />

            <DataGrid Grid.Column="2"
                      ItemsSource="{Binding SingleFlyDataModels}"
                      AlternationCount="2"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding SelectSingleCommand}"
                                               PassEventArgsToCommand="True" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <DataGrid.Columns>
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding FlyIndex}"
                                        Header="开枪次数" />
                    <DataGridTextColumn Width="2*"
                                        Binding="{Binding BeginTime, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}"
                                        Header="开始时间" />
                    <DataGridTextColumn Width="2*"
                                        Binding="{Binding EndTime, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}"
                                        Header="结束时间" />
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding FlyTime}"
                                        Header="开枪时长(s)" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <TextBlock Margin="10,0" Foreground="White" DockPanel.Dock="Right" FontSize="14" Text="{Binding AllFlyTime, Converter={StaticResource secondsToHMSConverter}, StringFormat= 总时长：{0} }"/>
            <TextBlock Margin="10,0" Foreground="White" DockPanel.Dock="Right" FontSize="14" Text="{Binding MaxSingleTime,Converter={StaticResource secondsToHMSConverter}, StringFormat= 单次最大开枪时长：{0} }"/>
        </DockPanel>
    </Grid>
</UserControl>
