<UserControl x:Class="UtilityTools.Views.SerialPortView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UtilityTools.Views"
             xmlns:cv="clr-namespace:UtilityTools.Core.Converter;assembly=UtilityTools.Core"
             mc:Ignorable="d" 
             Height="400"
             Width="280">
    <UserControl.Resources>
        <cv:StringToStopBitsConverter x:Key="StringToStopBitsConverter" />
        <cv:StringToIntConverter x:Key="StringToIntConverter" />
        <cv:StringToParityConverter x:Key="StringToParityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   LastChildFill="false">
            <TextBlock Text="串口设备"
                       FontWeight="Bold"
                       FontSize="20"
                       Padding="20, 10" />

            <Button x:Name="btnClose"
                    DockPanel.Dock="Right"
                    Content="✕"
                    Margin="5, 0"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignFlatMidBgButton}" />
        </DockPanel>


        <DockPanel Grid.Row="1"
                   LastChildFill="False">
            <TextBlock Text="串口选择"
                       Margin="20, 10"
                       DockPanel.Dock="Top"
                       FontSize="16" />
            <ComboBox DockPanel.Dock="Top"
                      Margin="20, 10"
                      ItemsSource="{Binding PortNames}"
                      SelectedItem="{Binding Model.PortName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Style="{StaticResource MaterialDesignComboBox}" />
            <DockPanel DockPanel.Dock="Top"
                       Margin="20, 10">
                <TextBlock Text="波特率"
                           DockPanel.Dock="Left"
                           FontSize="16"
                           Margin="0, 0, 10, 0" />
                <ComboBox DockPanel.Dock="Left"
                          ItemsSource="{Binding BaudRates, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectedItem="{Binding Model.BaudRate, Converter={StaticResource StringToIntConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource MaterialDesignComboBox}" />
            </DockPanel>
            <DockPanel DockPanel.Dock="Top"
                       Margin="20, 10">
                <TextBlock Text="停止位"
                           DockPanel.Dock="Left"
                           FontSize="16"
                           Margin="0, 0, 10, 0" />
                <ComboBox DockPanel.Dock="Left"
                          ItemsSource="{Binding StopBitsTypes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectedItem="{Binding Model.StopBitsType, Converter={StaticResource StringToStopBitsConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
                          Style="{StaticResource MaterialDesignComboBox}" />
            </DockPanel>
            <DockPanel DockPanel.Dock="Top"
                       Margin="20, 10">
                <TextBlock Text="数据位"
                           DockPanel.Dock="Left"
                           FontSize="16"
                           Margin="0, 0, 10, 0" />
                <ComboBox DockPanel.Dock="Left"
                          ItemsSource="{Binding DataBits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectedItem="{Binding Model.DataBits, Converter={StaticResource StringToIntConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource MaterialDesignComboBox}" />
            </DockPanel>
            <DockPanel DockPanel.Dock="Top"
                       Margin="20, 10">
                <TextBlock Text="校验位"
                           DockPanel.Dock="Left"
                           FontSize="16"
                           Margin="0, 0, 10, 0" />
                <ComboBox DockPanel.Dock="Left"
                          ItemsSource="{Binding ParityTypes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectedItem="{Binding Model.ParityType, Converter={StaticResource StringToParityConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource MaterialDesignComboBox}" />
            </DockPanel>
        </DockPanel>

        <Button Grid.Row="2"
                Content="{Binding Status}"
                Margin="10"
                HorizontalContentAlignment="Center"
                Command="{Binding SwitchCommand}" />
    </Grid>
</UserControl>
