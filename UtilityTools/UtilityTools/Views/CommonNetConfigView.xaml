<UserControl x:Class="UtilityTools.Views.CommonNetConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:items="clr-namespace:UtilityTools.UserControls.Views;assembly=UtilityTools.UserControls"
             xmlns:local="clr-namespace:UtilityTools.Views"
             mc:Ignorable="d"
             Height="400"
             Width="350">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   LastChildFill="false">
            <TextBlock Text="网络设备"
                       FontWeight="Bold"
                       FontSize="20"
                       Padding="20, 10" />

            <Button x:Name="btnClose"
                    DockPanel.Dock="Right"
                    Content="✕"
                    Margin="5, 0"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignFlatMidBgButton}" />
        </DockPanel>


        <DockPanel Grid.Row="1"
                   LastChildFill="False"
                   VerticalAlignment="Center">
            <DockPanel DockPanel.Dock="Top"
                       Margin="20, 10">
                <TextBlock Text="目标主机IP地址"
                           Margin="0, 0, 10, 0"
                           DockPanel.Dock="Left"
                           FontSize="16" />
                <items:IPTextBoxView DataContext="{Binding TargetIP}" />
            </DockPanel>

            <DockPanel DockPanel.Dock="Top"
                       Margin="20, 10">
                <TextBlock Text="目标主机端口号"
                           DockPanel.Dock="Left"
                           FontSize="16"
                           Margin="0, 0, 10, 0" />
                <TextBox Text="{Binding NetDevice.NetInfo.TargetPort}"
                         TextAlignment="Center" />
            </DockPanel>
            <DockPanel DockPanel.Dock="Top"
                       Margin="20, 10">
                <TextBlock Text="本地主机IP地址"
                           DockPanel.Dock="Left"
                           FontSize="16"
                           Margin="0, 0, 10, 0" />
                <items:IPTextBoxView DataContext="{Binding HostIP}" />
            </DockPanel>
            <DockPanel DockPanel.Dock="Top"
                       Margin="20, 10">
                <TextBlock Text="本地主机端口号"
                           DockPanel.Dock="Left"
                           FontSize="16"
                           Margin="0, 0, 10, 0" />
                <TextBox Text="{Binding NetDevice.NetInfo.HostPort}"
                         TextAlignment="Center" />
            </DockPanel>
        </DockPanel>

        <Button Grid.Row="2"
                Content="{Binding Status}"
                Margin="10"
                HorizontalContentAlignment="Center"
                Command="{Binding ExecuteCommand}"
                CommandParameter="ConnectOrNot" />
    </Grid>
</UserControl>
