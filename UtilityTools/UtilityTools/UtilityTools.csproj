<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>ZepTools.ico</ApplicationIcon>
    <AssemblyVersion>4.0.6.0</AssemblyVersion>
    <FileVersion>4.0.6.0</FileVersion>
    <InformationalVersion>v4.0.6</InformationalVersion>
    <Version>4.0.6</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- MotorTest 模块 LoadFrom 时从主程序目录解析 OpenXml / System.IO.Packaging（Modules 目录仅有模块 dll） -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.1.2" />
    <PackageReference Include="Prism.DryIoc" Version="8.1.97" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UtilityTools.Core\UtilityTools.Core.csproj" />
    <ProjectReference Include="..\Services\UtilityTools.Services.Interfaces\UtilityTools.Services.Interfaces.csproj" />
    <ProjectReference Include="..\Services\UtilityTools.Services\UtilityTools.Services.csproj" />
    <ProjectReference Include="..\UtilityTools.UserControls\UtilityTools.UserControls.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ContentWithTargetPath Include="$(SolutionDir)UtilityTools\bin\$(ConfigurationName)\$(TargetFramework)\Modules\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>Modules/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </ContentWithTargetPath>
  </ItemGroup>
  <ItemGroup>
    <Content Include="ZepTools.ico" />
  </ItemGroup>
</Project>