<prism:PrismApplication x:Class="UtilityTools.App"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="clr-namespace:UtilityTools"
                        xmlns:model="clr-namespace:UtilityTools.Core.Model;assembly=UtilityTools.Core"
                        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
                        xmlns:prism="http://prismlibrary.com/">
    <Application.Resources>
        <ResourceDictionary>

            <!--捆绑风格-->
            <ResourceDictionary.MergedDictionaries>
                <md:BundledTheme BaseTheme="Dark"
                                 PrimaryColor="DeepPurple"
                                 SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--列表样式-->
            <Style x:Key="MyListBoxItemStle"
                   TargetType="ListBoxItem">
                <Setter Property="MinHeight"
                        Value="40" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Grid>
                                <Border x:Name="borderHeader" />
                                <Border x:Name="border" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalAlignment}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected"
                                         Value="True">
                                    <Setter Property="BorderThickness"
                                            TargetName="borderHeader"
                                            Value="4,0,0,0" />
                                    <Setter Property="BorderBrush"
                                            TargetName="borderHeader"
                                            Value="{DynamicResource PrimaryHueLightBrush}" />
                                    <Setter Property="Background"
                                            TargetName="border"
                                            Value="{DynamicResource PrimaryHueLightBrush}" />
                                    <Setter Property="Opacity"
                                            TargetName="border"
                                            Value="0.3" />
                                </Trigger>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            TargetName="border"
                                            Value="{DynamicResource PrimaryHueLightBrush}" />
                                    <Setter Property="Opacity"
                                            TargetName="border"
                                            Value="0.3" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--显示读取参数模板-->
            <DataTemplate x:Key="labelInfoTemplate"
                          DataType="{x:Type model:LabelInfoModel}">
                <DockPanel LastChildFill="True"
                           VerticalAlignment="Center">
                    <Label Content="{Binding Name}"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center" />
                    <Label Content="{Binding Value}"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center" />
                </DockPanel>
            </DataTemplate>

            <!--显示滑块参数模板-->
            <DataTemplate x:Key="intSliderInfoTemplate"
                          DataType="{x:Type model:IntSliderInfoModel}">
                <DockPanel LastChildFill="True"
                           VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               DockPanel.Dock="Left" />
                    <TextBox Text="{Binding Value}"
                             DockPanel.Dock="Right"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center" />
                    <Slider Value="{Binding Value}"
                            Maximum="{Binding MaxValue}"
                            Minimum="{Binding MinValue}"
                            Interval="{Binding Interval}"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            Margin="10, 0, 10, 0" />
                </DockPanel>
            </DataTemplate>

            <!--显示滑块参数模板-->
            <DataTemplate x:Key="doubleSliderInfoTemplate"
                          DataType="{x:Type model:DoubleSliderInfoModel}">
                <DockPanel LastChildFill="True"
                           VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               DockPanel.Dock="Left" />
                    <TextBox Text="{Binding Value, StringFormat={}{0:2}}"
                             DockPanel.Dock="Right"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center" />
                    <Slider Value="{Binding Value}"
                            Maximum="{Binding MaxValue}"
                            Minimum="{Binding MinValue}"
                            Interval="{Binding Interval}"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            Margin="10, 0, 10, 0" />
                </DockPanel>
            </DataTemplate>

            <!--显示滑块参数模板-->
            <DataTemplate x:Key="floatSliderInfoTemplate"
                          DataType="{x:Type model:FloatSliderInfoModel}">
                <DockPanel LastChildFill="True"
                           VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               DockPanel.Dock="Left" />
                    <TextBox Text="{Binding Value, StringFormat={}{0:2}}"
                             DockPanel.Dock="Right"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center" />
                    <Slider Value="{Binding Value}"
                            Maximum="{Binding MaxValue}"
                            Minimum="{Binding MinValue}"
                            Interval="{Binding Interval}"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            Margin="10, 0, 10, 0" />
                </DockPanel>
            </DataTemplate>

            <!--显示切换按钮参数模板-->
            <DataTemplate x:Key="toggleInfoTemplate"
                          DataType="{x:Type model:ToggleInfoModel}">
                <DockPanel LastChildFill="True"
                           VerticalAlignment="Center">
                    <Label Content="{Binding Name}"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           DockPanel.Dock="Left" />
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="关" />
                        <ToggleButton Margin="8,0,8,0"
                                      IsChecked="{Binding Enable}" />
                        <TextBlock Text="开" />
                    </StackPanel>
                </DockPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>
