<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl ="clr-namespace:UtilityTools.Core.Controls;assembly=UtilityTools.Core">
    <Color x:Key="NormalBackgroundColor">#FF3E3E3E</Color>
    <Color x:Key="HoverBackgroundColor">#FF4F4F4F</Color>
    <Color x:Key="SelectedBackgroundColor">#FF4772B3</Color>
    <Color x:Key="DisableBackgroundColor">#FF1F1F1F</Color>

    <Color x:Key="NormalForegroundColor">#FFD7D7D7</Color>
    <Color x:Key="HoverForegroundColor">#FFD7D7D7</Color>
    <Color x:Key="SelectedForegroundColor">#FFD7D7D7</Color>
    <Color x:Key="DisableForegroundColor">#FF4F4F4F</Color>

    <Color x:Key="NormalGradientDeepColor">#FF272727</Color>
    <Color x:Key="NormalGradientLightColor">#FF3C3C3C</Color>
    <Color x:Key="HoverGradientDeepColor">#FF2F2F2F</Color>
    <Color x:Key="HoverGradientLightColor">#FF4A4A4A</Color>
    <Color x:Key="DisableGradientDeepColor">#FF1B1A1A</Color>
    <Color x:Key="DisableGradientLightColor">#FF252525</Color>

    <Color x:Key="NormalButtonBorderColor">#FF4E4E4E</Color>
    <Color x:Key="HoverButtonBorderColor">#FF636363</Color>
    <Color x:Key="DisableButtonBorderColor">#FF353535</Color>

    <Brush x:Key="NormalButtonBorderBrush">#FF4E4E4E</Brush>
    <Brush x:Key="HoverButtonBorderBrush">#FF636363</Brush>
    <Brush x:Key="DisableButtonBorderBrush">#FF353535</Brush>

    <SolidColorBrush x:Key="NormalBackgroundBrush"
                 Color="{StaticResource NormalBackgroundColor}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush"
                 Color="{StaticResource HoverBackgroundColor}" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush"
                 Color="{StaticResource SelectedBackgroundColor}" />
    <SolidColorBrush x:Key="DisableBackgroundBrush"
                 Color="{StaticResource DisableBackgroundColor}" />
    <SolidColorBrush x:Key="NormalForegroundBrush"
                 Color="{StaticResource NormalForegroundColor}" />
    <SolidColorBrush x:Key="HoverForegroundBrush"
                 Color="{StaticResource HoverForegroundColor}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush"
                 Color="{StaticResource SelectedForegroundColor}" />
    <SolidColorBrush x:Key="DisableForegroundBrush"
                 Color="{StaticResource DisableForegroundColor}" />

    <LinearGradientBrush x:Key="NormalGradientBrush"
                     StartPoint="0, 0"
                     EndPoint="0, 1">
        <GradientStop Color="{StaticResource NormalGradientLightColor}"
                  Offset="0" />
        <GradientStop Color="{StaticResource NormalGradientDeepColor}"
                  Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HoverGradientBrush"
                     StartPoint="0, 0"
                     EndPoint="0, 1">
        <GradientStop Color="{StaticResource HoverGradientLightColor}"
                  Offset="0" />
        <GradientStop Color="{StaticResource HoverGradientDeepColor}"
                  Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DisableGradientBrush"
                     StartPoint="0, 0"
                     EndPoint="0, 1">
        <GradientStop Color="{StaticResource DisableGradientLightColor}"
                  Offset="0" />
        <GradientStop Color="{StaticResource DisableGradientDeepColor}"
                  Offset="1" />
    </LinearGradientBrush>

    <Brush x:Key="SliderDeBarBackground">#FF4772B3</Brush>
    <Brush x:Key="SliderDeBarBordColor">#FF4D7CC3</Brush>
    <Brush x:Key="SliderBarBackground">#FF0C0C0C</Brush>
    <Brush x:Key="SliderBarBordColor">#FF3E3E3E</Brush>

    <Brush x:Key="SilkBackground">#FF131313</Brush>
    <Brush x:Key="SilkForeground">#FF05C15F</Brush>

    <Brush x:Key="WindowBackgroundBrush">#FF161616</Brush>
    <Brush x:Key="StaffBackgroundBrush">#FFD9D9D9</Brush>

    <Brush x:Key="MenuViewBackgroundBrush">#FF000000</Brush>
    <Brush x:Key="MenuViewContentBrush">#FF303030</Brush>
    <Brush x:Key="MenuTitleForegroundBrush">#FFFFFFFF</Brush>
    <Style TargetType="{x:Type ctrl:RelayToggleButton}">
        <Setter Property="Background"
              Value="{DynamicResource NormalBackgroundBrush}" />
        <Setter Property="BorderBrush"
              Value="{DynamicResource NormalButtonBorderBrush}" />
        <Setter Property="Foreground"
              Value="{DynamicResource NormalForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:RelayToggleButton}">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="GradientStops[0].Color"
                                                      Storyboard.TargetName="BackgroundBrush"
                                                      To="{StaticResource SelectedBackgroundColor}"
                                                      Duration="0:0:0.2" />
                                        <ColorAnimation Storyboard.TargetProperty="GradientStops[1].Color"
                                                      Storyboard.TargetName="BackgroundBrush"
                                                      To="{StaticResource SelectedBackgroundColor}"
                                                      Duration="0:0:0.2" />
                                        <ColorAnimation Storyboard.TargetProperty="Foreground.Color"
                                                      Storyboard.TargetName="content"
                                                      To="{StaticResource SelectedForegroundColor}"
                                                      Duration="0:0:0.2" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="GradientStops[0].Color"
                                                      Storyboard.TargetName="BackgroundBrush"
                                                      To="{StaticResource NormalGradientLightColor}"
                                                      Duration="0:0:0.2" />
                                        <ColorAnimation Storyboard.TargetProperty="GradientStops[1].Color"
                                                      Storyboard.TargetName="BackgroundBrush"
                                                      To="{StaticResource NormalGradientDeepColor}"
                                                      Duration="0:0:0.2" />
                                        <ColorAnimation Storyboard.TargetProperty="Foreground.Color"
                                                      Storyboard.TargetName="content"
                                                      To="{StaticResource NormalForegroundColor}"
                                                      Duration="0:0:0.2" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver" />
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="GradientStops[0].Color"
                                                      Storyboard.TargetName="BackgroundBrush"
                                                      To="{StaticResource DisableGradientLightColor}"
                                                      Duration="0:0:0.2" />
                                        <ColorAnimation Storyboard.TargetProperty="GradientStops[1].Color"
                                                      Storyboard.TargetName="BackgroundBrush"
                                                      To="{StaticResource DisableGradientDeepColor}"
                                                      Duration="0:0:0.2" />
                                        <ColorAnimation Storyboard.TargetProperty="Foreground.Color"
                                                      Storyboard.TargetName="content"
                                                      To="{StaticResource DisableForegroundColor}"
                                                      Duration="0:0:0.2" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="border"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              UseLayoutRounding="True">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BackgroundBrush"
                                                   StartPoint="0,0"
                                                   EndPoint="0,1">
                                    <GradientBrush.GradientStops>
                                        <GradientStopCollection>
                                            <GradientStop Color="{DynamicResource NormalGradientLightColor}"
                                                        Offset="0.0" />
                                            <GradientStop Color="{DynamicResource NormalGradientDeepColor}"
                                                        Offset="1.0" />
                                        </GradientStopCollection>
                                    </GradientBrush.GradientStops>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Label x:Name="content"
                                 Content="{TemplateBinding Content}"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Foreground="{TemplateBinding Foreground}"
                                 Background="Transparent" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>